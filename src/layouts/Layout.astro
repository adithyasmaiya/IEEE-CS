---
import '../styles/global.css';
import BaseHead from '../components/BaseHead.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Loader from '../components/Loader.astro';

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonicalURL?: string | URL;
}

const { title, description, image, canonicalURL } = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <script is:inline>
      (() => {
        try {
          const navEntries = performance.getEntriesByType('navigation');
          const isReload = navEntries.length > 0 && navEntries[0].type === 'reload';

          const path = window.location.pathname;
          const isLanding = path === '/' || path === '' || path === '/index.html';

          if (isReload) {
            if (!isLanding) {
              window.location.replace('/');
            } else {
              if (window.location.hash) {
                window.history.replaceState(null, '', '/');
              }
              if ('scrollRestoration' in history) {
                history.scrollRestoration = 'manual';
              }
              window.scrollTo(0, 0);
              window.addEventListener('DOMContentLoaded', () => window.scrollTo(0, 0));
              window.addEventListener('load', () => window.scrollTo(0, 0));
            }
          }
        } catch (e) {}
      })();
    </script>
    <BaseHead
      title={title}
      description={description}
      image={image}
      canonicalURL={canonicalURL}
    />
  </head>
  <body>
    <div id="top" tabindex="-1" style="position:absolute;top:0;left:0;width:1px;height:1px;pointer-events:none;opacity:0"></div>
    <Loader />
    <a href="#main-content" class="skip-to-content">Skip to content</a>
    <Nav />
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    <Footer />

    <script>
      (() => {
        const root = document.documentElement;
        root.classList.add('js');

        const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const fine = window.matchMedia('(pointer: fine)').matches;

        // Current Year
        const y = document.getElementById('year');
        if (y) y.textContent = String(new Date().getFullYear());

        // Nav scrolled state
        const nav = document.querySelector('.nav');
        if (nav) {
          const onScroll = () => {
            nav.classList.toggle('scrolled', window.scrollY > 24);
          };
          onScroll();
          window.addEventListener('scroll', onScroll, { passive: true });
        }

        // Accessible Mobile Menu Drawer with Focus Trap
        const menuBtn = document.getElementById('menuBtn');
        const menu = document.getElementById('mobileMenu');
        if (menuBtn && menu) {
          const focusableEls = () => menu.querySelectorAll<HTMLElement>('a, button, [tabindex="0"]');

          const setMenu = (open: boolean) => {
            root.classList.toggle('menu-open', open);
            menuBtn.setAttribute('aria-expanded', String(open));
            menuBtn.setAttribute('aria-label', open ? 'Close navigation menu' : 'Open navigation menu');
            menu.setAttribute('aria-hidden', String(!open));
            document.body.style.overflow = open ? 'hidden' : '';

            if (open) {
              const firstFocusable = focusableEls()[0];
              firstFocusable?.focus();
            } else {
              menuBtn.focus();
            }
          };

          menuBtn.addEventListener('click', () => {
            const isOpen = root.classList.contains('menu-open');
            setMenu(!isOpen);
          });

          menu.querySelectorAll('[data-close]').forEach((el) => {
            el.addEventListener('click', () => setMenu(false));
          });

          window.addEventListener('keydown', (e: KeyboardEvent) => {
            if (!root.classList.contains('menu-open')) return;

            if (e.key === 'Escape') {
              setMenu(false);
              return;
            }

            if (e.key === 'Tab') {
              const focusables = Array.from(focusableEls());
              if (focusables.length === 0) return;
              const first = focusables[0];
              const last = focusables[focusables.length - 1];

              if (e.shiftKey && document.activeElement === first) {
                e.preventDefault();
                last.focus();
              } else if (!e.shiftKey && document.activeElement === last) {
                e.preventDefault();
                first.focus();
              }
            }
          });

          window.matchMedia('(min-width: 861px)').addEventListener('change', (e) => {
            if (e.matches && root.classList.contains('menu-open')) {
              setMenu(false);
            }
          });
        }

        // ANIMATION 1 — Cinematic Hero Text Reveal on Initial Load
        const hero = document.getElementById('hero');
        if (hero) {
          if (reduce) {
            hero.classList.add('hero-entered');
          } else {
            // Two RAF ticks guarantee initial styles are committed before transition begins
            requestAnimationFrame(() => {
              requestAnimationFrame(() => {
                hero.classList.add('hero-entered');
              });
            });
          }
        }

        // ANIMATION 2 — Scroll-Triggered Reveals via IntersectionObserver
        const revealEls = document.querySelectorAll('.reveal, .reveal-mask, .draw-line');
        if (reduce || !('IntersectionObserver' in window)) {
          revealEls.forEach((el) => el.classList.add('in'));
        } else {
          const io = new IntersectionObserver(
            (entries) => {
              entries.forEach((entry) => {
                if (entry.isIntersecting) {
                  entry.target.classList.add('in');
                  io.unobserve(entry.target);
                }
              });
            },
            { threshold: 0.08, rootMargin: '0px 0px -4% 0px' }
          );
          revealEls.forEach((el) => io.observe(el));
        }

        // BFCache / page restoration handling for reveals
        window.addEventListener('pageshow', (e) => {
          if (e.persisted) {
            document.querySelectorAll('.reveal, .reveal-mask, .draw-line').forEach((el) => {
              const rect = el.getBoundingClientRect();
              if (rect.top < window.innerHeight) {
                el.classList.add('in');
              }
            });
          }
        });

        // ANIMATION 2 — Scroll-Tied Roadmap Progress Indicator
        const roadmapBlock = document.getElementById('roadmapBlock');
        if (roadmapBlock) {
          const progressLine = roadmapBlock.querySelector<HTMLElement>('.timeline-progress');
          const milestones = roadmapBlock.querySelectorAll<HTMLElement>('.milestone');
          const roadmapContainer = roadmapBlock.closest('.roadmap');

          if (reduce || !('IntersectionObserver' in window)) {
            roadmapContainer?.classList.add('in');
            if (progressLine) progressLine.style.setProperty('--timeline-w', '100%');
            milestones.forEach((m) => m.classList.add('node-lit'));
          } else {
            let roadmapActive = false;
            let ticking = false;

            const updateProgress = () => {
              const rect = roadmapBlock.getBoundingClientRect();
              const vh = window.innerHeight;
              const start = vh * 0.85;
              const end = vh * 0.25;
              const rawProgress = (start - rect.top) / (start - end);
              const clampedProgress = Math.min(1, Math.max(0, rawProgress));

              if (progressLine) {
                progressLine.style.setProperty('--timeline-w', `${(clampedProgress * 100).toFixed(1)}%`);
              }

              milestones.forEach((m, idx) => {
                const threshold = (idx / (milestones.length - 1)) * 0.88;
                if (clampedProgress >= threshold) {
                  m.classList.add('node-lit');
                } else if (clampedProgress < threshold - 0.08) {
                  m.classList.remove('node-lit');
                }
              });

              ticking = false;
            };

            const onRoadmapScroll = () => {
              if (!ticking && roadmapActive) {
                ticking = true;
                requestAnimationFrame(updateProgress);
              }
            };

            const roadmapObserver = new IntersectionObserver(
              (entries) => {
                entries.forEach((entry) => {
                  roadmapActive = entry.isIntersecting;
                  if (roadmapActive) {
                    roadmapContainer?.classList.add('in');
                    window.addEventListener('scroll', onRoadmapScroll, { passive: true });
                    updateProgress();
                  } else {
                    window.removeEventListener('scroll', onRoadmapScroll);
                  }
                });
              },
              { threshold: 0.05 }
            );
            roadmapObserver.observe(roadmapBlock);
          }
        }

        // ANIMATION 2 — Viewport-Gated Subtle Parallax on Decorative SVGs Only
        if (!reduce) {
          const parallaxConfigs = [
            { sectionId: 'about', targetSelector: '.manifesto-art svg', factor: 0.06, maxOffset: 36 },
            { sectionId: 'register', targetSelector: '.final-art svg', factor: 0.10, maxOffset: 50 }
          ];

          parallaxConfigs.forEach(({ sectionId, targetSelector, factor, maxOffset }) => {
            const section = document.getElementById(sectionId);
            if (!section) return;
            const target = section.querySelector<HTMLElement>(targetSelector);
            if (!target) return;

            let sectionActive = false;
            let sectionTicking = false;

            const updateSectionParallax = () => {
              const rect = section.getBoundingClientRect();
              const centerDelta = (window.innerHeight * 0.5) - (rect.top + rect.height * 0.5);
              const offset = Math.max(-maxOffset, Math.min(maxOffset, centerDelta * factor));
              target.style.setProperty('--scroll-y', `${offset.toFixed(1)}px`);
              target.style.setProperty('--art-scroll-y', `${offset.toFixed(1)}px`);
              sectionTicking = false;
            };

            const onSectionScroll = () => {
              if (!sectionTicking && sectionActive) {
                sectionTicking = true;
                requestAnimationFrame(updateSectionParallax);
              }
            };

            const sectionObserver = new IntersectionObserver((entries) => {
              entries.forEach((entry) => {
                sectionActive = entry.isIntersecting;
                if (sectionActive) {
                  window.addEventListener('scroll', onSectionScroll, { passive: true });
                  updateSectionParallax();
                } else {
                  window.removeEventListener('scroll', onSectionScroll);
                }
              });
            }, { threshold: 0.02 });

            sectionObserver.observe(section);
          });
        }

        // Custom Cursor (fine pointers only, decorative, pointer-events: none, never hides native cursor)
        if (fine && !reduce) {
          const dot = document.createElement('div');
          dot.className = 'cursor';
          dot.setAttribute('aria-hidden', 'true');
          document.body.appendChild(dot);

          let mx = 0;
          let my = 0;
          let dx = 0;
          let dy = 0;

          window.addEventListener(
            'pointermove',
            (e: PointerEvent) => {
              mx = e.clientX;
              my = e.clientY;
              dot.classList.add('on');
            },
            { passive: true }
          );

          document.addEventListener('pointerleave', () => {
            dot.classList.remove('on');
          });

          const loop = () => {
            dx += (mx - dx) * 0.22;
            dy += (my - dy) * 0.22;
            dot.style.transform = `translate3d(${dx}px, ${dy}px, 0)`;
            requestAnimationFrame(loop);
          };
          loop();

          document.querySelectorAll('[data-hover], a, button, summary').forEach((el) => {
            el.addEventListener('pointerenter', () => dot.classList.add('hover'));
            el.addEventListener('pointerleave', () => dot.classList.remove('hover'));
          });
        }

        // Theme rows: touch-friendly preview toggle
        document.querySelectorAll('.theme').forEach((t) => {
          t.addEventListener('click', () => {
            if (window.matchMedia('(hover: none)').matches) {
              t.classList.toggle('active');
            }
          });
        });
      })();
    </script>
  </body>
</html>
