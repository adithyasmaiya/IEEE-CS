---
import Layout from '../layouts/Layout.astro';
import Cta from '../components/Cta.astro';
import PageHeader from '../components/PageHeader.astro';
import { EVENT_CONFIG, EVENT_METRICS, EVENT_PROVISIONS } from '../data/event';
import { THEMES_LIST } from '../data/themes';

const { registration, eventDetails } = EVENT_CONFIG;
const hasRegistrationUrl = Boolean(registration.isOpen && registration.googleFormsUrl);

const pageTitle = `Register · ${EVENT_CONFIG.name} ${EVENT_CONFIG.edition} · ${EVENT_CONFIG.organizer}`;
const pageDescription = `Register for ${EVENT_CONFIG.name} ${EVENT_CONFIG.edition} — the flagship hackathon of ${EVENT_CONFIG.organizer} at ${EVENT_CONFIG.university}, ${EVENT_CONFIG.city}. Apply with your team, explore tracks, and secure your hacker spot.`;
---

<Layout title={pageTitle} description={pageDescription}>
  <!-- Page Header -->
  <PageHeader
    index="05 — Registration"
    label="Application Portal · Cohort Admissions"
    supertitle={`Edition ${EVENT_CONFIG.edition} · Team Admissions Live`}
    title="Registration"
    titleOutline="Portal"
    titleId="register-page-title"
    paddingBottom="clamp(3rem, 6vw, 4.5rem)"
  >
    <div style="max-width:46ch">
      <p class="lede reveal" style="--d:.1s;margin:0 0 1.2rem">
        Join 120+ shortlisted teams of builders, systems researchers, and engineers converging at {EVENT_CONFIG.university}, {EVENT_CONFIG.city}.
      </p>
      <div class="label reveal" style="--d:.15s;border-left:2px solid var(--acid);padding-left:1rem;color:var(--ink)">
        {hasRegistrationUrl ? (
          <>Status: <span style="color:var(--acid);font-weight:600">OFFICIAL GOOGLE FORM OPEN</span> · {eventDetails.dateText}</>
        ) : (
          <>Status: <span style="color:var(--acid);font-weight:600">OFFICIAL FORM LINK PENDING</span> · {eventDetails.dateText}</>
        )}
      </div>
    </div>
  </PageHeader>

  <!-- Visual Feature & Hackathon Atmosphere Showcase -->
  <section class="section" style="padding-top:0;padding-bottom:clamp(3rem, 5vw, 4.5rem)" aria-label="Hackathon Showcase">
    <div class="wrap">
      <div class="reveal showcase-split-box">
        <!-- Left Side: Enlarged Visual Photo Banner -->
        <div class="showcase-visual-side">
          <picture class="showcase-pic">
            <source srcset="/images/hackathon-collab.webp" type="image/webp" />
            <img
              src="/images/hackathon-collab.jpg"
              alt="Confluence Hackathon participants actively building and coding prototypes at PES University"
              class="showcase-img"
              loading="eager"
              decoding="async"
              width="1376"
              height="768"
            />
          </picture>
          <div class="showcase-overlay" aria-hidden="true"></div>
          
          <div class="showcase-top-badges">
            <span class="label label-ink" style="background:rgba(10,10,10,0.85);backdrop-filter:blur(8px);border:1px solid var(--line)">
              {EVENT_CONFIG.university} RR Campus
            </span>
            <span class="label" style="background:rgba(10,10,10,0.85);backdrop-filter:blur(8px);color:var(--acid);border:1px solid var(--acid)">
              ● In-Person 36h Sprint
            </span>
          </div>

          <div class="showcase-bottom-left">
            <p class="label" style="margin:0 0 .35rem;color:var(--muted)">Hackathon Atmosphere</p>
            <h3 style="font-family:var(--display);font-size:clamp(1.35rem, 2.2vw, 1.95rem);font-weight:700;margin:0;color:var(--ink);line-height:1.15">
              Where Code Meets Hardware &amp; Craft
            </h3>
          </div>
        </div>

        <!-- Right Side: The 4 Columns Arranged One by One Below -->
        <div class="showcase-metrics-side" aria-label="Key Event Metrics">
          {EVENT_METRICS.map((metric) => (
            <div class="metric-row">
              <span class="metric-label">{metric.label}</span>
              <div class={`metric-val ${metric.isAccent ? 'metric-val-acid' : ''}`}>{metric.value}</div>
              <span class="metric-sub">{metric.sub}</span>
            </div>
          ))}
        </div>
      </div>

      <!-- On-Site Provisions & Experience Panel Cleanly Below Banner -->
      <div class="reveal showcase-provisions-panel" aria-label="Hackathon Provisions & Experience" style="margin-top:2.5rem">
        <div class="provisions-header-row">
          <div>
            <span class="idx">02 // ON-SITE PROVISIONS &amp; INFRASTRUCTURE</span>
            <h4 class="provisions-title">
              What Happens On-Site
            </h4>
          </div>
          <div class="provisions-lede-wrap">
            <span class="label" style="display:inline-block;margin-bottom:.4rem;color:var(--acid);font-weight:700">36H CONTINUOUS SPRINT</span>
            <p class="provisions-lede">
              Confluence is built for high-velocity hardware and systems engineering. From your first commit to the grand auditorium demo, every participant receives complete infrastructure:
            </p>
          </div>
        </div>

        <div class="showcase-features-grid">
          {EVENT_PROVISIONS.map((item) => (
            <div class="feature-item">
              <span class="feature-num">[ {item.number} ]</span>
              <div class="feature-content">
                <span class="feature-title">{item.title}</span>
                <p class="feature-desc">{item.description}</p>
              </div>
            </div>
          ))}
        </div>

        <div class="showcase-info-foot">
          <div class="foot-badge">
            <span class="dot">●</span> 120+ Teams Shortlisted
          </div>
          <div class="foot-badge">
            <span class="dot">●</span> ₹1,50,000+ Prize Pool
          </div>
          <div class="foot-badge">
            <span class="dot">●</span> 100% Free Entry
          </div>
          <div class="foot-badge">
            <span class="dot">●</span> Hardware Kits &amp; Cloud Credits
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Status & Application Card Section -->
  <section class="section grid-lines-x" aria-labelledby="status-board-title" style="padding-top:clamp(2rem, 4vw, 3rem)">
    <div class="wrap">
      <div class="section-head reveal">
        <span class="idx">Admissions</span>
        <span class="label">Criteria &amp; Application Guidelines</span>
      </div>

      <div style="display:flex;justify-content:space-between;align-items:flex-end;margin-bottom:2.5rem;flex-wrap:wrap;gap:1.5rem">
        <div>
          <h2 class="h2 reveal" id="status-board-title" style="margin:0;font-size:clamp(2rem, 4vw, 3rem)">
            Team <span class="outline-text">Admissions</span>
          </h2>
        </div>
        <p class="body reveal" style="max-width:44ch;margin:0">
          Review the requirements below and prepare your team application for Confluence 2026.
        </p>
      </div>

      <!-- Official Google Form Link Status / Transparency Callout -->
      {!hasRegistrationUrl ? (
        <div class="reveal" style="border:1px dashed var(--line-strong);background:rgba(200,255,46,0.03);padding:1.4rem 1.8rem;margin-bottom:2.5rem;display:flex;align-items:flex-start;gap:1.2rem">
          <span style="color:var(--acid);font-family:var(--mono);font-size:1.1rem;font-weight:700">[NOTICE]</span>
          <div>
            <span class="label" style="color:var(--acid);display:block;margin-bottom:.3rem">
              OFFICIAL GOOGLE FORMS LINK PENDING CONFIGURATION
            </span>
            <p class="body" style="margin:0;font-size:.88rem;line-height:1.5">
              The official Google Forms destination is currently pending release by the organizing committee (<code style="font-family:var(--mono);color:var(--acid);font-size:.85rem">EVENT_CONFIG.registration.googleFormsUrl</code> is currently unset). Official registrations will be accepted solely through that Google Form once published. In the meantime, you can draft and save your team profile and project concept locally in your browser below.
            </p>
          </div>
        </div>
      ) : (
        <div class="reveal" style="border:1px solid var(--acid);background:rgba(200,255,46,0.06);padding:1.4rem 1.8rem;margin-bottom:2.5rem;display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:1.2rem">
          <div>
            <span class="label" style="color:var(--acid);display:block;margin-bottom:.3rem">
              ● OFFICIAL REGISTRATION PORTAL READY
            </span>
            <p class="body" style="margin:0;font-size:.9rem;line-height:1.4">
              The official Google Form for Confluence 2026 team registration is live and receiving submissions.
            </p>
          </div>
          <a
            href={registration.googleFormsUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-primary"
            data-hover
          >
            Go to Official Google Form ↗
          </a>
        </div>
      )}

      <div style="display:grid;grid-template-columns:repeat(auto-fit, minmax(min(100%, 320px), 1fr));gap:clamp(1.5rem, 3vw, 2.5rem);margin-bottom:3.5rem">
        <!-- Main Form / Status Card -->
        <div class="reveal" style="border:1px solid var(--line);background:var(--bg-2);padding:clamp(2rem, 4vw, 3rem);display:flex;flex-direction:column;justify-content:space-between">
          <div>
            <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:1.5rem">
              <span class="label">Admissions Channel</span>
              {hasRegistrationUrl ? (
                <span class="idx" style="font-size:.7rem;border:1px solid var(--acid);color:var(--acid);padding:.2rem .6rem">GOOGLE FORMS LIVE</span>
              ) : (
                <span class="idx" style="font-size:.7rem;border:1px solid var(--line-strong);color:var(--muted);padding:.2rem .6rem">FORM LINK PENDING</span>
              )}
            </div>

            <h3 class="display" style="font-size:clamp(1.8rem, 3.5vw, 2.5rem);line-height:1;margin:0 0 1.2rem">
              Apply for Confluence 2026
            </h3>

            <p class="body" style="margin:0 0 1.5rem">
              {hasRegistrationUrl
                ? "Official registrations are being collected via the official IEEE CS PESU Google Form. Click below to submit your team application directly."
                : "Official registration will be collected via the IEEE CS PESU Google Form. The registration URL is currently pending announcement by the organizers. Teams may prepare and store their proposal draft locally below in advance."}
            </p>

            <div style="border-top:1px solid var(--line);padding-top:1.2rem;margin-bottom:2rem">
              <div style="display:flex;justify-content:space-between;padding:.5rem 0;border-bottom:1px solid var(--line)">
                <span class="label">Event Dates</span>
                <span style="font-weight:600;color:var(--ink)">{eventDetails.dateText}</span>
              </div>
              <div style="display:flex;justify-content:space-between;padding:.5rem 0;border-bottom:1px solid var(--line)">
                <span class="label">Venue</span>
                <span style="font-weight:600;color:var(--ink);text-align:right">{eventDetails.venueText}</span>
              </div>
              <div style="display:flex;justify-content:space-between;padding:.5rem 0;border-bottom:1px solid var(--line)">
                <span class="label">Registration Fee</span>
                <span style="font-weight:600;color:var(--acid)">{(registration.feeText?.split('·')[0].trim() || '100% Free')} (Sponsored)</span>
              </div>
              <div style="display:flex;justify-content:space-between;padding:.5rem 0">
                <span class="label">Team Size Limit</span>
                <span style="font-weight:600;color:var(--ink)">{eventDetails.teamSizeText}</span>
              </div>
            </div>
          </div>

          <div>
            {hasRegistrationUrl ? (
              <>
                <a
                  href={registration.googleFormsUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="btn btn-primary"
                  data-hover
                  style="width:100%;justify-content:space-between"
                >
                  Open Official Google Form <span class="arrow">↗</span>
                </a>
                <a
                  href="#apply-form"
                  class="btn btn-ghost"
                  data-hover
                  style="width:100%;margin-top:.75rem;justify-content:space-between;border-style:dashed"
                >
                  Draft Proposal Locally First <span class="arrow">↓</span>
                </a>
              </>
            ) : (
              <a
                href="#apply-form"
                class="btn btn-primary"
                data-hover
                style="width:100%;justify-content:space-between"
              >
                Draft Proposal Locally <span class="arrow">↓</span>
              </a>
            )}
          </div>
        </div>

        <!-- Checklist Card -->
        <div class="reveal" style="--d:.1s;border:1px solid var(--line);background:var(--bg-2);padding:clamp(2rem, 4vw, 3rem);display:flex;flex-direction:column;justify-content:space-between">
          <div>
            <span class="label" style="display:block;margin-bottom:1.5rem">Prerequisites</span>
            <h3 class="display" style="font-size:clamp(1.8rem, 3.5vw, 2.5rem);line-height:1;margin:0 0 1.2rem">
              Application Checklist
            </h3>
            <p class="body" style="margin:0 0 1.5rem">
              Prepare the following details before completing your team registration:
            </p>

            <ol style="list-style:none;padding:0;margin:0;display:grid;gap:1.1rem">
              {registration.instructions?.map((step, idx) => (
                <li style="display:grid;grid-template-columns:36px 1fr;align-items:start">
                  <span class="idx" style="font-size:.85rem">0{idx + 1}.</span>
                  <span class="body" style="font-size:.92rem;color:var(--ink)">{step}</span>
                </li>
              ))}
            </ol>
          </div>

          <div style="border-top:1px solid var(--line);padding-top:1.2rem;margin-top:2rem;display:flex;justify-content:space-between;align-items:flex-end;flex-wrap:wrap;gap:1rem">
            <div style="max-width:32ch">
              <span class="label" style="display:block;margin-bottom:.4rem">Eligibility Policy</span>
              <p class="coords" style="margin:0;color:var(--muted);font-size:.78rem;line-height:1.4">
                {eventDetails.eligibilityText}
              </p>
            </div>
            <div style="display:flex;gap:.8rem;align-items:center;flex-wrap:wrap">
              <span class="label" style="color:var(--acid)">GitHub · <a href="https://github.com/IEEE-CS-PESU" target="_blank" rel="noopener noreferrer" style="color:var(--acid);text-decoration:none">IEEE-CS-PESU ↗</a></span>
              <span style="color:var(--line-strong)">·</span>
              <span class="label" style="color:var(--acid)">Discord · <a href="https://discord.com/invite/7kpmFp2uuU" target="_blank" rel="noopener noreferrer" style="color:var(--acid);text-decoration:none">Community ↗</a></span>
              <span style="color:var(--line-strong)">·</span>
              <span class="label" style="color:var(--acid)">LinkedIn · <a href="https://www.linkedin.com/company/ieeecspesu/home" target="_blank" rel="noopener noreferrer" style="color:var(--acid);text-decoration:none">IEEE CS PESU ↗</a></span>
              <span style="color:var(--line-strong)">·</span>
              <span class="label" style="color:var(--acid)">Instagram · <a href="https://www.instagram.com/ieee.cs.pesu" target="_blank" rel="noopener noreferrer" style="color:var(--acid);text-decoration:none">@ieee.cs.pesu ↗</a></span>
            </div>
          </div>
        </div>
      </div>

      <!-- Interactive Team Application Draft Section -->
      <div id="apply-form" class="reveal" style="border:1px solid var(--line);background:var(--bg-2);padding:clamp(2rem, 5vw, 4rem)">
        <div class="section-head" style="border-top:0;padding-top:0;margin-bottom:2rem">
          <span class="idx">Draft Tool</span>
          <span class="label">Team Proposal &amp; Application Preparation · Edition 2026</span>
        </div>

        <div style="margin-bottom:2.5rem">
          <h3 class="display" style="font-size:clamp(1.8rem, 3.5vw, 2.8rem);margin:0 0 .8rem">
            Prepare Your Team Application
          </h3>
          <p class="body" style="margin:0;max-width:64ch">
            Draft your team credentials, problem track selection, and technical concept below. Submitting this form saves your draft locally in your browser's localStorage so your team can easily copy and paste into the official Google Form.
          </p>
          <p class="coords" style="margin:.8rem 0 0;color:var(--acid);font-size:.8rem">
            * Note: Storing a draft here does NOT submit your registration to the IEEE CS PESU organizers. Official entry requires submitting via the Google Form.
          </p>
        </div>

        <form id="teamRegForm" class="reg-form-grid">
          <div>
            <label for="teamName" class="label" style="display:block;margin-bottom:.6rem;color:var(--ink)">
              Team Name *
            </label>
            <input
              type="text"
              id="teamName"
              name="teamName"
              required
              placeholder="e.g. Kernel Architects"
              style="width:100%;padding:.9rem 1.2rem;background:var(--bg);border:1px solid var(--line);color:var(--ink);font-family:var(--mono);font-size:.9rem;outline:none"
            />
          </div>

          <div>
            <label for="teamSize" class="label" style="display:block;margin-bottom:.6rem;color:var(--ink)">
              Team Size *
            </label>
            <select
              id="teamSize"
              name="teamSize"
              required
              style="width:100%;padding:.9rem 1.2rem;background:var(--bg);border:1px solid var(--line);color:var(--ink);font-family:var(--mono);font-size:.9rem;outline:none"
            >
              <option value="2">2 Members</option>
              <option value="3">3 Members</option>
              <option value="4" selected>4 Members (Recommended)</option>
            </select>
          </div>

          <div>
            <label for="leadName" class="label" style="display:block;margin-bottom:.6rem;color:var(--ink)">
              Team Leader Full Name *
            </label>
            <input
              type="text"
              id="leadName"
              name="leadName"
              required
              placeholder="e.g. Adithya Rao"
              style="width:100%;padding:.9rem 1.2rem;background:var(--bg);border:1px solid var(--line);color:var(--ink);font-family:var(--mono);font-size:.9rem;outline:none"
            />
          </div>

          <div>
            <label for="leadEmail" class="label" style="display:block;margin-bottom:.6rem;color:var(--ink)">
              Team Leader College Email *
            </label>
            <input
              type="email"
              id="leadEmail"
              name="leadEmail"
              required
              placeholder="e.g. leader@pesu.pes.edu"
              style="width:100%;padding:.9rem 1.2rem;background:var(--bg);border:1px solid var(--line);color:var(--ink);font-family:var(--mono);font-size:.9rem;outline:none"
            />
          </div>

          <div>
            <label for="institution" class="label" style="display:block;margin-bottom:.6rem;color:var(--ink)">
              Institution / University *
            </label>
            <input
              type="text"
              id="institution"
              name="institution"
              required
              placeholder="e.g. PES University, Bengaluru"
              style="width:100%;padding:.9rem 1.2rem;background:var(--bg);border:1px solid var(--line);color:var(--ink);font-family:var(--mono);font-size:.9rem;outline:none"
            />
          </div>

          <div>
            <label for="track" class="label" style="display:block;margin-bottom:.6rem;color:var(--ink)">
              Primary Problem Track *
            </label>
            <select
              id="track"
              name="track"
              required
              style="width:100%;padding:.9rem 1.2rem;background:var(--bg);border:1px solid var(--line);color:var(--ink);font-family:var(--mono);font-size:.9rem;outline:none"
            >
              {THEMES_LIST.map((theme) => (
                <option value={`${theme.trackTag.split(' · ')[0]} · ${theme.title}`}>
                  {theme.trackTag.split(' · ')[0]} · {theme.title}
                </option>
              ))}
            </select>
          </div>

          <div style="grid-column:1 / -1">
            <label for="proposal" class="label" style="display:block;margin-bottom:.6rem;color:var(--ink)">
              Project Concept &amp; Technical Approach (2-4 Sentences) *
            </label>
            <textarea
              id="proposal"
              name="proposal"
              rows="3"
              required
              placeholder="Describe the problem, the tech stack you plan to build with (hardware, frameworks, protocols), and what prototype you aim to demonstrate at Confluence 2026."
              style="width:100%;padding:.9rem 1.2rem;background:var(--bg);border:1px solid var(--line);color:var(--ink);font-family:var(--mono);font-size:.88rem;outline:none;resize:vertical"
            ></textarea>
          </div>

          <div style="grid-column:1 / -1;display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:1.5rem;padding-top:1rem;border-top:1px solid var(--line)">
            <p class="coords" style="margin:0;color:var(--muted)">
              Saves to browser localStorage for easy copying. Official registration requires the Google Form.
            </p>
            <button
              type="submit"
              class="btn btn-primary"
              data-hover
              id="submitBtn"
              style="padding:1rem 2.2rem"
            >
              Save Application Draft Locally <span class="arrow">→</span>
            </button>
          </div>
        </form>

        <!-- Dynamic Success Receipt Card (Shown upon draft save) -->
        <div
          id="successReceipt"
          style="display:none;background:var(--bg);border:1px solid var(--acid);padding:2.5rem;margin-top:2rem"
          aria-live="polite"
        >
          <div style="display:flex;justify-content:space-between;align-items:flex-start;flex-wrap:wrap;gap:1rem;margin-bottom:1.5rem">
            <div>
              <span class="label" style="color:var(--acid);font-weight:700">✓ DRAFT SAVED LOCALLY (BROWSER STORAGE)</span>
              <h4 style="font-family:var(--display);font-size:1.8rem;margin:.4rem 0 0;color:var(--ink)">
                Team Profile Draft Stored
              </h4>
            </div>
            <span class="idx" id="receiptId" style="border:1px solid var(--line-strong);padding:.4rem .8rem;font-size:.85rem">
              DRAFT-CNF26-XXXX
            </span>
          </div>

          <p class="body" style="margin:0 0 1.2rem;color:#E0DCD4">
            Your team proposal draft has been saved to this browser's local storage. You can copy the generated summary below or edit your draft anytime.
          </p>

          <div style="border-left:2px solid var(--acid);background:var(--bg-2);padding:1rem 1.4rem;margin-bottom:1.8rem">
            <span class="label" style="color:var(--acid);display:block;margin-bottom:.3rem">
              OFFICIAL SUBMISSION REQUIRED:
            </span>
            <p class="body" style="margin:0;font-size:.88rem;color:var(--ink);line-height:1.45">
              This draft has <strong>NOT</strong> been transmitted to the organizers. Official entry for Confluence 2026 must be submitted through the official Google Form.
              {hasRegistrationUrl ? (
                <> Please proceed to the Google Form below to finalize your registration.</>
              ) : (
                <> Once the official Google Form URL is published by the organizing committee, paste these details to complete registration.</>
              )}
            </p>
          </div>

          <div style="display:flex;gap:1rem;flex-wrap:wrap">
            {hasRegistrationUrl && (
              <a
                href={registration.googleFormsUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="btn btn-primary"
                data-hover
              >
                Open Official Google Form ↗
              </a>
            )}
            <button
              type="button"
              id="copyDraftBtn"
              class="btn btn-primary"
              data-hover
            >
              Copy Draft Summary 📋
            </button>
            <button
              type="button"
              id="resetFormBtn"
              class="btn btn-ghost"
              style="border-style:dashed"
            >
              Edit Draft Details
            </button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <Cta />

  <script>
    const form = document.getElementById('teamRegForm') as HTMLFormElement | null;
    const successReceipt = document.getElementById('successReceipt');
    const receiptIdSpan = document.getElementById('receiptId');
    const resetBtn = document.getElementById('resetFormBtn');
    const copyBtn = document.getElementById('copyDraftBtn');

    let currentDraftSummary = '';

    if (form && successReceipt && receiptIdSpan) {
      // Check if a saved draft already exists in localStorage
      try {
        const saved = localStorage.getItem('confluence_registration_draft');
        if (saved) {
          const data = JSON.parse(saved);
          const teamNameInput = document.getElementById('teamName') as HTMLInputElement | null;
          const teamSizeSelect = document.getElementById('teamSize') as HTMLSelectElement | null;
          const leadNameInput = document.getElementById('leadName') as HTMLInputElement | null;
          const leadEmailInput = document.getElementById('leadEmail') as HTMLInputElement | null;
          const institutionInput = document.getElementById('institution') as HTMLInputElement | null;
          const trackSelect = document.getElementById('track') as HTMLSelectElement | null;
          const proposalTextarea = document.getElementById('proposal') as HTMLTextAreaElement | null;

          if (teamNameInput && data.teamName) teamNameInput.value = data.teamName;
          if (teamSizeSelect && data.teamSize) teamSizeSelect.value = data.teamSize;
          if (leadNameInput && data.leadName) leadNameInput.value = data.leadName;
          if (leadEmailInput && data.leadEmail) leadEmailInput.value = data.leadEmail;
          if (institutionInput && data.institution) institutionInput.value = data.institution;
          if (trackSelect && data.track) trackSelect.value = data.track;
          if (proposalTextarea && data.proposal) proposalTextarea.value = data.proposal;
        }
      } catch {}

      form.addEventListener('submit', (e) => {
        e.preventDefault();
        const formData = new FormData(form);
        const randomId = 'DRAFT-CNF26-' + Math.floor(1000 + Math.random() * 9000);
        
        receiptIdSpan.textContent = randomId;
        
        const entry = {
          id: randomId,
          teamName: formData.get('teamName'),
          teamSize: formData.get('teamSize'),
          leadName: formData.get('leadName'),
          leadEmail: formData.get('leadEmail'),
          institution: formData.get('institution'),
          track: formData.get('track'),
          proposal: formData.get('proposal'),
          savedAt: new Date().toISOString()
        };

        currentDraftSummary = 
`--- CONFLUENCE 2026 TEAM APPLICATION DRAFT ---
Draft ID: ${entry.id}
Team Name: ${entry.teamName}
Team Size: ${entry.teamSize} members
Team Leader: ${entry.leadName} (${entry.leadEmail})
Institution: ${entry.institution}
Primary Track: ${entry.track}

Project Concept & Abstract:
${entry.proposal}

[Saved locally for submission into official Google Form]`;

        try {
          localStorage.setItem('confluence_registration_draft', JSON.stringify(entry));
        } catch {}

        form.style.display = 'none';
        successReceipt.style.display = 'block';
        successReceipt.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      });

      if (resetBtn) {
        resetBtn.addEventListener('click', () => {
          form.style.display = 'grid';
          successReceipt.style.display = 'none';
        });
      }

      if (copyBtn) {
        copyBtn.addEventListener('click', async () => {
          try {
            if (currentDraftSummary) {
              await navigator.clipboard.writeText(currentDraftSummary);
              const original = copyBtn.textContent;
              copyBtn.textContent = '✓ Copied to Clipboard!';
              setTimeout(() => {
                copyBtn.textContent = original;
              }, 2500);
            }
          } catch {}
        });
      }
    }
  </script>
  <style>
