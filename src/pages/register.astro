---
import Layout from '../layouts/Layout.astro';
import Cta from '../components/Cta.astro';
import { EVENT_CONFIG } from '../data/event';
import { THEMES_LIST } from '../data/themes';

const { registration, eventDetails } = EVENT_CONFIG;

const pageTitle = `Register · ${EVENT_CONFIG.name} ${EVENT_CONFIG.edition} · ${EVENT_CONFIG.organizer}`;
const pageDescription = `Register for ${EVENT_CONFIG.name} ${EVENT_CONFIG.edition} — the flagship hackathon of ${EVENT_CONFIG.organizer} at ${EVENT_CONFIG.university}, ${EVENT_CONFIG.city}. Apply with your team, explore tracks, and secure your hacker spot.`;
---

<Layout title={pageTitle} description={pageDescription}>
  <!-- Page Header -->
  <section class="section grid-lines" style="padding-top:clamp(7.5rem, 14vw, 10.5rem);padding-bottom:clamp(3rem, 6vw, 4.5rem)" aria-labelledby="register-page-title">
    <div class="wrap">
      <div class="section-head reveal">
        <span class="idx">05 — Registration</span>
        <span class="label">Application Portal · Cohort Admissions</span>
      </div>

      <div style="display:flex;justify-content:space-between;align-items:flex-end;gap:2.5rem;flex-wrap:wrap">
        <div>
          <span class="label label-ink" style="display:block;margin-bottom:.8rem">
            Edition {EVENT_CONFIG.edition} · Team Admissions Live
          </span>
          <h1 class="h2 reveal" id="register-page-title" style="margin:0;line-height:.88">
            Registration<br />
            <span class="outline-text">Portal</span>
          </h1>
        </div>
        <div style="max-width:46ch">
          <p class="lede reveal" style="--d:.1s;margin:0 0 1.2rem">
            Join 120+ shortlisted teams of builders, systems researchers, and engineers converging at {EVENT_CONFIG.university}, {EVENT_CONFIG.city}.
          </p>
          <div class="label reveal" style="--d:.15s;border-left:2px solid var(--acid);padding-left:1rem;color:var(--ink)">
            Status: <span style="color:var(--acid);font-weight:600">APPLICATIONS ACTIVE</span> · {eventDetails.dateText}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Visual Feature & Hackathon Atmosphere Showcase -->
  <section class="section" style="padding-top:0;padding-bottom:clamp(3rem, 5vw, 4.5rem)" aria-label="Hackathon Showcase">
    <div class="wrap">
      <div class="reveal" style="position:relative;border:1px solid var(--line);background:var(--bg-2);overflow:hidden">
        <div class="showcase-banner">
          <picture class="showcase-pic">
            <source srcset="/images/hackathon-collab.webp" type="image/webp" />
            <img
              src="/images/hackathon-collab.jpg"
              alt="Confluence Hackathon participants actively building and coding prototypes at PES University"
              class="showcase-img"
              loading="eager"
              decoding="async"
              width="1376"
              height="768"
            />
          </picture>
          <div class="showcase-overlay" aria-hidden="true"></div>
          
          <div class="showcase-top-badges">
            <span class="label label-ink" style="background:rgba(10,10,10,0.85);backdrop-filter:blur(8px);border:1px solid var(--line)">
              {EVENT_CONFIG.university} RR Campus
            </span>
            <span class="label" style="background:rgba(10,10,10,0.85);backdrop-filter:blur(8px);color:var(--acid);border:1px solid var(--acid)">
              ● In-Person 36h Sprint
            </span>
          </div>

          <div class="showcase-bottom-left">
            <p class="label" style="margin:0 0 .3rem;color:var(--muted)">Hackathon Atmosphere</p>
            <h3 style="font-family:var(--display);font-size:clamp(1.3rem, 2.5vw, 1.9rem);font-weight:600;margin:0;color:var(--ink)">
              Where Code Meets Hardware &amp; Craft
            </h3>
            <span class="coords" style="display:inline-block;margin-top:.4rem;color:#BDB9AF;background:rgba(10,10,10,0.7);padding:.25rem .6rem">
              {EVENT_CONFIG.coordinates}
            </span>
          </div>

          <!-- Right Side Hackathon Highlights & Provisions Card -->
          <aside class="showcase-right-card" aria-label="Hackathon Provisions & Experience">
            <div class="showcase-card-head">
              <span class="idx">ON-SITE LAB PROVISIONS</span>
              <span class="label" style="color:var(--acid);font-weight:700">36H LIVE</span>
            </div>
            
            <h4 class="showcase-card-title">
              What Happens On-Site
            </h4>

            <ul class="showcase-perks-list">
              <li>
                <span class="perk-bullet">01</span>
                <div>
                  <strong>Hardware &amp; IoT Testbenches</strong>
                  <span>ESP32, STM32, soldering stations, oscilloscopes &amp; dedicated lab power drops.</span>
                </div>
              </li>
              <li>
                <span class="perk-bullet">02</span>
                <div>
                  <strong>Continuous Mentor Cadence</strong>
                  <span>Direct architectural unblocking with domain mentors across AI, systems &amp; hardware.</span>
                </div>
              </li>
              <li>
                <span class="perk-bullet">03</span>
                <div>
                  <strong>24/7 Hacker Fuel &amp; Meals</strong>
                  <span>Full hot meals, midnight energy drinks, coffee &amp; quiet resting zones included.</span>
                </div>
              </li>
              <li>
                <span class="perk-bullet">04</span>
                <div>
                  <strong>Grand Auditorium Stage Finale</strong>
                  <span>Finalist teams present working prototypes before industry judges &amp; peers.</span>
                </div>
              </li>
            </ul>

            <div class="showcase-card-foot">
              <span style="color:var(--acid);font-weight:600">● ₹1,50,000+ Prize Pool</span>
              <span style="color:var(--ink)">100% Free · Kits Included</span>
            </div>
          </aside>
        </div>

        <!-- Key Metrics Strip -->
        <div class="reg-metrics-grid">
          <div class="reg-metric-item">
            <span class="label" style="display:block;margin-bottom:.3rem;color:var(--muted)">Sprint Duration</span>
            <span style="font-family:var(--display);font-size:1.6rem;font-weight:700;color:var(--ink)">36 Hours</span>
            <span class="coords" style="display:block;margin-top:.2rem">Continuous On-Site</span>
          </div>
          <div class="reg-metric-item">
            <span class="label" style="display:block;margin-bottom:.3rem;color:var(--muted)">Prize Pool</span>
            <span style="font-family:var(--display);font-size:1.6rem;font-weight:700;color:var(--acid)">₹1,50,000+</span>
            <span class="coords" style="display:block;margin-top:.2rem">Cash &amp; Incubation</span>
          </div>
          <div class="reg-metric-item">
            <span class="label" style="display:block;margin-bottom:.3rem;color:var(--muted)">Team Capacity</span>
            <span style="font-family:var(--display);font-size:1.6rem;font-weight:700;color:var(--ink)">2–4 Builders</span>
            <span class="coords" style="display:block;margin-top:.2rem">Cross-Disciplinary</span>
          </div>
          <div class="reg-metric-item">
            <span class="label" style="display:block;margin-bottom:.3rem;color:var(--muted)">Registration Fee</span>
            <span style="font-family:var(--display);font-size:1.6rem;font-weight:700;color:var(--ink)">100% Free</span>
            <span class="coords" style="display:block;margin-top:.2rem">Meals &amp; Kits Included</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Status & Application Card Section -->
  <section class="section grid-lines-x" aria-labelledby="status-board-title" style="padding-top:clamp(2rem, 4vw, 3rem)">
    <div class="wrap">
      <div class="section-head reveal">
        <span class="idx">Admissions</span>
        <span class="label">Criteria &amp; Application Guidelines</span>
      </div>

      <div style="display:flex;justify-content:space-between;align-items:flex-end;margin-bottom:2.5rem;flex-wrap:wrap;gap:1.5rem">
        <div>
          <h2 class="h2 reveal" id="status-board-title" style="margin:0;font-size:clamp(2rem, 4vw, 3rem)">
            Team <span class="outline-text">Admissions</span>
          </h2>
        </div>
        <p class="body reveal" style="max-width:44ch;margin:0">
          Review the requirements below and submit your team application to reserve your seats for Confluence 2026.
        </p>
      </div>

      <div style="display:grid;grid-template-columns:repeat(auto-fit, minmax(min(100%, 380px), 1fr));gap:2.5rem;margin-bottom:3.5rem">
        <!-- Main Form / Status Card -->
        <div class="reveal" style="border:1px solid var(--line);background:var(--bg-2);padding:clamp(2rem, 4vw, 3rem);display:flex;flex-direction:column;justify-content:space-between">
          <div>
            <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:1.5rem">
              <span class="label">Admissions Status</span>
              <span class="idx" style="font-size:.7rem;border:1px solid var(--acid);color:var(--acid);padding:.2rem .6rem">APPLICATIONS LIVE</span>
            </div>

            <h3 class="display" style="font-size:clamp(1.8rem, 3.5vw, 2.5rem);line-height:1;margin:0 0 1.2rem">
              Apply for Confluence 2026
            </h3>

            <p class="body" style="margin:0 0 1.5rem">
              Applications are officially open. Submit your team lead credentials, team members, and track preference directly below or via our verified portal.
            </p>

            <div style="border-top:1px solid var(--line);padding-top:1.2rem;margin-bottom:2rem">
              <div style="display:flex;justify-content:space-between;padding:.5rem 0;border-bottom:1px solid var(--line)">
                <span class="label">Event Dates</span>
                <span style="font-weight:600;color:var(--ink)">{eventDetails.dateText}</span>
              </div>
              <div style="display:flex;justify-content:space-between;padding:.5rem 0;border-bottom:1px solid var(--line)">
                <span class="label">Venue</span>
                <span style="font-weight:600;color:var(--ink);text-align:right">{eventDetails.venueText}</span>
              </div>
              <div style="display:flex;justify-content:space-between;padding:.5rem 0;border-bottom:1px solid var(--line)">
                <span class="label">Registration Fee</span>
                <span style="font-weight:600;color:var(--acid)">100% Free (Sponsored)</span>
              </div>
              <div style="display:flex;justify-content:space-between;padding:.5rem 0">
                <span class="label">Team Size Limit</span>
                <span style="font-weight:600;color:var(--ink)">{eventDetails.teamSizeText}</span>
              </div>
            </div>
          </div>

          <div>
            <a
              href="#apply-form"
              class="btn btn-primary"
              data-hover
              style="width:100%;justify-content:space-between"
            >
              Fill Application Form <span class="arrow">↓</span>
            </a>
          </div>
        </div>

        <!-- Checklist Card -->
        <div class="reveal" style="--d:.1s;border:1px solid var(--line);background:var(--bg-2);padding:clamp(2rem, 4vw, 3rem);display:flex;flex-direction:column;justify-content:space-between">
          <div>
            <span class="label" style="display:block;margin-bottom:1.5rem">Prerequisites</span>
            <h3 class="display" style="font-size:clamp(1.8rem, 3.5vw, 2.5rem);line-height:1;margin:0 0 1.2rem">
              Application Checklist
            </h3>
            <p class="body" style="margin:0 0 1.5rem">
              Prepare the following details before completing your team registration:
            </p>

            <ol style="list-style:none;padding:0;margin:0;display:grid;gap:1.1rem">
              {registration.instructions?.map((step, idx) => (
                <li style="display:grid;grid-template-columns:36px 1fr;align-items:start">
                  <span class="idx" style="font-size:.85rem">0{idx + 1}.</span>
                  <span class="body" style="font-size:.92rem;color:var(--ink)">{step}</span>
                </li>
              ))}
            </ol>
          </div>

          <div style="border-top:1px solid var(--line);padding-top:1.2rem;margin-top:2rem">
            <span class="label" style="display:block;margin-bottom:.4rem">Eligibility Policy</span>
            <p class="coords" style="margin:0;color:var(--muted);font-size:.78rem;line-height:1.4">
              {eventDetails.eligibilityText}
            </p>
          </div>
        </div>
      </div>

      <!-- Live Interactive Team Application Form -->
      <div id="apply-form" class="reveal" style="border:1px solid var(--line);background:var(--bg-2);padding:clamp(2rem, 5vw, 4rem)">
        <div class="section-head" style="border-top:0;padding-top:0;margin-bottom:2rem">
          <span class="idx">Portal</span>
          <span class="label">Team Registration Form · Edition 2026</span>
        </div>

        <div style="margin-bottom:2.5rem">
          <h3 class="display" style="font-size:clamp(1.8rem, 3.5vw, 2.8rem);margin:0 0 .8rem">
            Submit Your Team Profile
          </h3>
          <p class="body" style="margin:0;max-width:60ch">
            Fill out your team credentials below to register for Confluence 2026. Submissions will be reviewed on a rolling basis by the IEEE CS PESU admissions committee.
          </p>
        </div>

        <form id="teamRegForm" class="reg-form-grid">
          <div>
            <label for="teamName" class="label" style="display:block;margin-bottom:.6rem;color:var(--ink)">
              Team Name *
            </label>
            <input
              type="text"
              id="teamName"
              name="teamName"
              required
              placeholder="e.g. Kernel Architects"
              style="width:100%;padding:.9rem 1.2rem;background:var(--bg);border:1px solid var(--line);color:var(--ink);font-family:var(--mono);font-size:.9rem;outline:none"
            />
          </div>

          <div>
            <label for="teamSize" class="label" style="display:block;margin-bottom:.6rem;color:var(--ink)">
              Team Size *
            </label>
            <select
              id="teamSize"
              name="teamSize"
              required
              style="width:100%;padding:.9rem 1.2rem;background:var(--bg);border:1px solid var(--line);color:var(--ink);font-family:var(--mono);font-size:.9rem;outline:none"
            >
              <option value="2">2 Members</option>
              <option value="3">3 Members</option>
              <option value="4" selected>4 Members (Recommended)</option>
            </select>
          </div>

          <div>
            <label for="leadName" class="label" style="display:block;margin-bottom:.6rem;color:var(--ink)">
              Team Leader Full Name *
            </label>
            <input
              type="text"
              id="leadName"
              name="leadName"
              required
              placeholder="e.g. Adithya Rao"
              style="width:100%;padding:.9rem 1.2rem;background:var(--bg);border:1px solid var(--line);color:var(--ink);font-family:var(--mono);font-size:.9rem;outline:none"
            />
          </div>

          <div>
            <label for="leadEmail" class="label" style="display:block;margin-bottom:.6rem;color:var(--ink)">
              Team Leader College Email *
            </label>
            <input
              type="email"
              id="leadEmail"
              name="leadEmail"
              required
              placeholder="e.g. leader@pesu.pes.edu"
              style="width:100%;padding:.9rem 1.2rem;background:var(--bg);border:1px solid var(--line);color:var(--ink);font-family:var(--mono);font-size:.9rem;outline:none"
            />
          </div>

          <div>
            <label for="institution" class="label" style="display:block;margin-bottom:.6rem;color:var(--ink)">
              Institution / University *
            </label>
            <input
              type="text"
              id="institution"
              name="institution"
              required
              placeholder="e.g. PES University, Bengaluru"
              style="width:100%;padding:.9rem 1.2rem;background:var(--bg);border:1px solid var(--line);color:var(--ink);font-family:var(--mono);font-size:.9rem;outline:none"
            />
          </div>

          <div>
            <label for="track" class="label" style="display:block;margin-bottom:.6rem;color:var(--ink)">
              Primary Problem Track *
            </label>
            <select
              id="track"
              name="track"
              required
              style="width:100%;padding:.9rem 1.2rem;background:var(--bg);border:1px solid var(--line);color:var(--ink);font-family:var(--mono);font-size:.9rem;outline:none"
            >
              {THEMES_LIST.map((theme) => (
                <option value={`${theme.trackTag.split(' · ')[0]} · ${theme.title}`}>
                  {theme.trackTag.split(' · ')[0]} · {theme.title}
                </option>
              ))}
            </select>
          </div>

          <div style="grid-column:1 / -1">
            <label for="proposal" class="label" style="display:block;margin-bottom:.6rem;color:var(--ink)">
              Project Concept &amp; Technical Approach (2-4 Sentences) *
            </label>
            <textarea
              id="proposal"
              name="proposal"
              rows="3"
              required
              placeholder="Describe the problem, the tech stack you plan to build with (hardware, frameworks, protocols), and what prototype you aim to demonstrate at Confluence 2026."
              style="width:100%;padding:.9rem 1.2rem;background:var(--bg);border:1px solid var(--line);color:var(--ink);font-family:var(--mono);font-size:.88rem;outline:none;resize:vertical"
            ></textarea>
          </div>

          <div style="grid-column:1 / -1;display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:1.5rem;padding-top:1rem;border-top:1px solid var(--line)">
            <p class="coords" style="margin:0;color:var(--muted)">
              By registering, you agree to the IEEE CS PESU Code of Conduct and on-site event policies.
            </p>
            <button
              type="submit"
              class="btn btn-primary"
              data-hover
              id="submitBtn"
              style="padding:1rem 2.2rem"
            >
              Submit Application <span class="arrow">→</span>
            </button>
          </div>
        </form>

        <!-- Dynamic Success Receipt Card (Shown upon submission) -->
        <div
          id="successReceipt"
          style="display:none;background:var(--bg);border:1px solid var(--acid);padding:2.5rem;margin-top:2rem"
          aria-live="polite"
        >
          <div style="display:flex;justify-content:space-between;align-items:flex-start;flex-wrap:wrap;gap:1rem;margin-bottom:1.5rem">
            <div>
              <span class="label" style="color:var(--acid);font-weight:700">✓ APPLICATION CONFIRMED</span>
              <h4 style="font-family:var(--display);font-size:1.8rem;margin:.4rem 0 0;color:var(--ink)">
                Welcome to Confluence 2026
              </h4>
            </div>
            <span class="idx" id="receiptId" style="border:1px solid var(--line-strong);padding:.4rem .8rem;font-size:.85rem">
              CNF26-XXXX
            </span>
          </div>

          <p class="body" style="margin:0 0 1.5rem;color:#E0DCD4">
            Your team registration has been recorded. Our admissions team will review your project abstract and reach out via your team leader email with the hacker kit and on-site check-in credentials.
          </p>

          <div style="display:flex;gap:1rem;flex-wrap:wrap">
            <a
              href="https://github.com/pesu-ieeecs"
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn-ghost"
              data-hover
            >
              IEEE CS PESU GitHub ↗
            </a>
            <button
              type="button"
              id="resetFormBtn"
              class="btn btn-ghost"
              style="border-style:dashed"
            >
              Register Another Team
            </button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <Cta />

  <script>
    const form = document.getElementById('teamRegForm') as HTMLFormElement | null;
    const successReceipt = document.getElementById('successReceipt');
    const receiptIdSpan = document.getElementById('receiptId');
    const resetBtn = document.getElementById('resetFormBtn');

    if (form && successReceipt && receiptIdSpan) {
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        const formData = new FormData(form);
        const randomId = 'CNF26-' + Math.floor(1000 + Math.random() * 9000);
        
        receiptIdSpan.textContent = randomId;
        
        // Save to localStorage as proof of registration
        const entry = {
          id: randomId,
          teamName: formData.get('teamName'),
          leadName: formData.get('leadName'),
          leadEmail: formData.get('leadEmail'),
          track: formData.get('track'),
          timestamp: new Date().toISOString()
        };
        try {
          localStorage.setItem('confluence_registration', JSON.stringify(entry));
        } catch (_) {}

        form.style.display = 'none';
        successReceipt.style.display = 'block';
        successReceipt.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      });

      if (resetBtn) {
        resetBtn.addEventListener('click', () => {
          form.reset();
          form.style.display = 'grid';
          successReceipt.style.display = 'none';
        });
      }
    }
  </script>
  <style>
    /* Hackathon Showcase Banner & Right-Side Experience Panel */
    .showcase-banner {
      position: relative;
      min-height: 520px;
      overflow: hidden;
      background: var(--bg);
    }

    .showcase-pic {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      display: block;
    }

    .showcase-img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: 25% 38%;
      display: block;
      filter: contrast(1.05) brightness(0.88);
    }

    .showcase-overlay {
      position: absolute;
      inset: 0;
      background: linear-gradient(90deg, 
        rgba(10, 10, 10, 0.25) 0%, 
        rgba(10, 10, 10, 0.45) 45%, 
        rgba(10, 10, 10, 0.88) 72%, 
        rgba(10, 10, 10, 0.98) 100%),
        linear-gradient(180deg, rgba(10,10,10,0.15) 0%, rgba(10,10,10,0.85) 100%);
      pointer-events: none;
    }

    .showcase-top-badges {
      position: absolute;
      top: 1.5rem;
      left: 1.5rem;
      display: flex;
      gap: 0.6rem;
      flex-wrap: wrap;
      z-index: 2;
    }

    .showcase-bottom-left {
      position: absolute;
      bottom: 1.5rem;
      left: 1.5rem;
      max-width: min(100% - 3rem, 520px);
      z-index: 2;
    }

    .showcase-right-card {
      position: absolute;
      top: 1.5rem;
      bottom: 1.5rem;
      right: 1.5rem;
      width: clamp(340px, 34vw, 480px);
      background: rgba(12, 12, 12, 0.88);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border: 1px solid var(--line-strong);
      border-left: 2px solid var(--acid);
      padding: 1.6rem 1.8rem;
      z-index: 3;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      gap: 1.1rem;
    }

    .showcase-card-head {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding-bottom: 0.6rem;
      border-bottom: 1px solid var(--line);
    }

    .showcase-card-title {
      font-family: var(--display);
      font-size: 1.25rem;
      font-weight: 700;
      color: var(--ink);
      margin: 0;
      line-height: 1.2;
      letter-spacing: -0.02em;
    }

    .showcase-perks-list {
      list-style: none;
      padding: 0;
      margin: 0;
      display: flex;
      flex-direction: column;
      gap: 0.8rem;
    }

    .showcase-perks-list li {
      display: grid;
      grid-template-columns: 28px 1fr;
      column-gap: 0.75rem;
      align-items: start;
    }

    .perk-bullet {
      font-family: var(--mono);
      font-size: 0.72rem;
      color: var(--acid);
      font-weight: 700;
      line-height: 1.4;
    }

    .showcase-perks-list li strong {
      display: block;
      font-family: var(--display);
      font-size: 0.88rem;
      color: var(--ink);
      margin-bottom: 0.15rem;
      font-weight: 600;
    }

    .showcase-perks-list li span {
      display: block;
