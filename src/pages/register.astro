      pointer-events: none;
    }

    .showcase-top-badges {
      position: absolute;
      top: 1.5rem;
      left: 1.5rem;
      display: flex;
      gap: 0.6rem;
      flex-wrap: wrap;
      z-index: 2;
    }

    .showcase-bottom-left {
      position: absolute;
      bottom: clamp(1.4rem, 2.5vw, 2rem);
      left: clamp(1.4rem, 2.5vw, 2rem);
      right: clamp(1.4rem, 2.5vw, 2rem);
      z-index: 2;
    }

    /* 4 Metrics Arranged One by One Below on the Right */
    .showcase-metrics-side {
      display: grid;
      grid-template-rows: repeat(4, 1fr);
      background: var(--bg-2);
    }

    .metric-row {
      padding: clamp(1.3rem, 1.8vw, 1.75rem) clamp(1.6rem, 2.4vw, 2.4rem);
