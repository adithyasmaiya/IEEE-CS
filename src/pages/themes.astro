---
import Layout from '../layouts/Layout.astro';
import Themes from '../components/Themes.astro';
import Cta from '../components/Cta.astro';
import PageHeader from '../components/PageHeader.astro';
import { EVENT_CONFIG } from '../data/event';
import { THEMES_NOTE, JUDGING_CRITERIA } from '../data/themes';

const pageTitle = `Themes & Tracks · ${EVENT_CONFIG.name} ${EVENT_CONFIG.edition}`;
const pageDescription = `Explore the problem spaces and tracks for ${EVENT_CONFIG.name} ${EVENT_CONFIG.edition}. Four technical fields designed for interdisciplinary systems engineering at ${EVENT_CONFIG.university}, ${EVENT_CONFIG.city}.`;
---

<Layout title={pageTitle} description={pageDescription}>
  <!-- Page Header -->
  <PageHeader
    index="02 — Themes"
    label="Problem Spaces · Technical Arenas"
    supertitle={`Edition ${EVENT_CONFIG.edition} · Technical Tracks`}
    title="Problem"
    titleOutline="Spaces"
    titleId="themes-page-title"
  >
    <div style="max-width:44ch">
      <p class="lede reveal" style="--d:.1s;margin:0 0 1.2rem">
        Four convergent domains designed to challenge builders across infrastructure, intelligence, physical interfaces, and open innovation.
      </p>
      <div class="label reveal" style="--d:.15s;border-left:2px solid var(--acid);padding-left:1rem;color:var(--muted)">
        Official Briefs: <span style="color:var(--acid);font-weight:600">{THEMES_NOTE.officialStatus}</span>
      </div>
    </div>
  </PageHeader>

  <!-- Core Themes Interactive List (Shared Reusable Component) -->
  <Themes />

  <!-- Hardware & Systems Prototyping Showcase -->
  <section class="section" style="padding-top:0;padding-bottom:clamp(2rem, 4vw, 3rem)" aria-label="Hardware Prototyping Showcase">
    <div class="wrap">
      <div class="reveal" style="border:1px solid var(--line);background:var(--bg-2);overflow:hidden">
        <div style="position:relative;aspect-ratio:16/9;max-height:460px;overflow:hidden">
          <picture>
            <source srcset="/images/hardware-prototype.webp" type="image/webp" />
            <img
              src="/images/hardware-prototype.jpg"
              alt="Custom embedded hardware prototype with microcontrollers, sensors and telemetry built at Confluence Hackathon"
              style="width:100%;height:100%;object-fit:cover;object-position:center 60%;filter:contrast(1.06) brightness(0.92)"
              loading="lazy"
              decoding="async"
              width="1200"
              height="896"
            />
          </picture>
          <div style="position:absolute;inset:0;background:linear-gradient(180deg, rgba(10,10,10,0.1) 0%, rgba(10,10,10,0.85) 100%)"></div>
          
          <div style="position:absolute;top:1.5rem;left:1.5rem">
            <span class="label" style="background:rgba(10,10,10,0.85);backdrop-filter:blur(8px);border:1px solid var(--acid);color:var(--acid)">
              ● Physical Computing &amp; Edge Labs
            </span>
          </div>

          <div style="position:absolute;bottom:1.5rem;left:1.5rem;right:1.5rem;display:flex;justify-content:space-between;align-items:flex-end;flex-wrap:wrap;gap:1rem">
            <div>
              <p class="label" style="margin:0 0 .3rem;color:var(--muted)">Tactile Craft &amp; Telemetry</p>
              <h3 style="font-family:var(--display);font-size:clamp(1.2rem, 2.2vw, 1.8rem);font-weight:600;margin:0;color:var(--ink)">
                Bridging Custom Circuits with Low-Latency Software
              </h3>
            </div>
            <span class="coords" style="color:#BDB9AF;background:rgba(10,10,10,0.7);padding:.3rem .6rem">
              ESP32 · STM32 · Edge AI
            </span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Evaluation & Track Mechanics -->
  <section class="section grid-lines-x" aria-labelledby="eval-title">
    <div class="wrap">
      <div class="section-head reveal">
        <span class="idx">Evaluation</span>
        <span class="label">Craft Standards · Prototype Rigour</span>
      </div>

      <h2 class="h2 reveal" id="eval-title" style="margin:0 0 clamp(2rem, 4vw, 3rem);font-size:clamp(2rem, 4.5vw, 3.8rem);line-height:1">
        Craft Standards &amp; <span class="outline-text">Judging</span>
      </h2>

      <div style="display:grid;grid-template-columns:repeat(auto-fit, minmax(min(100%, 300px), 1fr));gap:2rem">
        {JUDGING_CRITERIA.map((criterion, idx) => (
          <div
            class="reveal"
            style={idx > 0 ? `--d:.${idx}s;border:1px solid var(--line);background:var(--bg-2);padding:clamp(1.5rem, 3vw, 2.5rem)` : `border:1px solid var(--line);background:var(--bg-2);padding:clamp(1.5rem, 3vw, 2.5rem)`}
          >
            <span class="idx" style="font-size:1.1rem;display:block;margin-bottom:.6rem">{criterion.index}</span>
            <h3 class="display" style="font-size:1.4rem;margin:0 0 .8rem">{criterion.title}</h3>
            <p class="body" style="font-size:.92rem;margin:0">
              {criterion.description}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <Cta />
</Layout>
