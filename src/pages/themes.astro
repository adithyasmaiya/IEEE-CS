---
import Layout from '../layouts/Layout.astro';
import { THEMES_LIST, THEMES_NOTE } from '../data/themes';
import { EVENT_CONFIG } from '../data/event';

const pageTitle = `Themes & Problem Tracks · ${EVENT_CONFIG.name} ${EVENT_CONFIG.edition}`;
const pageDescription = `Explore the technical problem spaces and tracks of CONFLUENCE 2026. Distributed infrastructure, applied agent intelligence, embedded cyber-physical systems, and open innovation.`;
---

<Layout title={pageTitle} description={pageDescription}>
  <!-- Page Header -->
  <section class="section grid-lines" style="padding-top:8.5rem;padding-bottom:clamp(3rem,6vw,5rem)">
    <div class="wrap">
      <div class="section-head reveal">
        <span class="idx">02 — Problem Spaces</span>
        <span class="label">Tracks · Technical Domains · Constraints</span>
      </div>

      <div style="display:flex;justify-content:space-between;align-items:flex-end;gap:2rem;flex-wrap:wrap">
        <div>
          <span class="label label-ink" style="display:block;margin-bottom:1rem">
            Edition {EVENT_CONFIG.edition} · Four Technical Arenas
          </span>
          <h1 class="h2 reveal" style="margin:0;line-height:.86">
            Problem<br />
            <span class="outline-text">Spaces</span>
          </h1>
        </div>
        <div style="max-width:44ch">
          <p class="lede reveal" style="--d:.1s;margin:0 0 1rem">
            Four convergent fields engineered for depth. Teams select a primary track or enter an unconventional wildcard prototype.
          </p>
          <div style="border-left:2px solid var(--acid);padding-left:1rem">
            <span class="label" style="display:block;color:var(--acid);margin-bottom:.2rem">Notice</span>
            <span class="body" style="font-size:.85rem;margin:0;display:block">
              {THEMES_NOTE.officialStatus}
            </span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Detailed Themes List -->
  <section class="section grid-lines-x">
    <div class="wrap">
      <div style="display:flex;flex-direction:column;gap:clamp(3rem,6vw,5rem)">
        {THEMES_LIST.map((theme, idx) => (
          <article
            class="reveal"
            id={theme.id}
            tabindex="0"
            style="border:1px solid var(--line);background:var(--bg-2);padding:clamp(2rem,4vw,3.5rem);position:relative;transition:border-color .3s"
          >
            <!-- Top Row -->
            <div style="display:flex;justify-content:space-between;align-items:flex-start;gap:1.5rem;flex-wrap:wrap;border-bottom:1px solid var(--line);padding-bottom:1.5rem;margin-bottom:2rem">
              <div style="display:flex;align-items:baseline;gap:1rem">
                <span class="idx" style="font-size:1.4rem">{theme.number}</span>
                <span class="label" style="border:1px solid var(--line-strong);padding:.25rem .6rem">
                  {theme.trackTag}
                </span>
              </div>
              <span class="label coords">
                FIG. 0{idx + 1} // TRACK_SPEC
              </span>
            </div>

            <!-- Content Grid: Visual Art + Text Details -->
            <div style="display:grid;grid-template-columns:1fr 240px;gap:clamp(2rem,4vw,4rem);align-items:start">
              <div>
                <h2 style="font-size:clamp(1.8rem,3.4vw,2.8rem);font-weight:800;letter-spacing:-.04em;line-height:1.05;margin:0 0 1.2rem;text-transform:uppercase">
                  {theme.title}
                  {theme.isPlaceholderTitle && (
                    <span class="ph" style="font-size:.38em;vertical-align:middle;margin-left:.4rem">[DRAFT SPEC TBA]</span>
                  )}
                </h2>

                <p class="lede" style="font-size:1.1rem;margin:0 0 1.5rem;color:var(--ink)">
                  {theme.description}
                </p>

                {theme.systemFocus && (
                  <div style="background:var(--bg);border:1px solid var(--line);padding:1.2rem;margin-bottom:1.5rem">
                    <span class="label" style="display:block;margin-bottom:.4rem;color:var(--acid)">
                      System Focus &amp; Core Architecture
                    </span>
                    <p style="margin:0;font-family:var(--mono);font-size:.85rem;color:var(--ink-secondary)">
                      {theme.systemFocus}
                    </p>
                  </div>
                )}

                {theme.details && theme.details.length > 0 && (
                  <div style="margin-bottom:1.5rem">
                    <span class="label" style="display:block;margin-bottom:.6rem">Technical Expectations</span>
                    <ul style="margin:0;padding-left:1.2rem;display:grid;gap:.5rem;color:var(--muted)">
                      {theme.details.map((detail) => (
                        <li style="font-size:.95rem">{detail}</li>
                      ))}
                    </ul>
                  </div>
                )}

                {theme.criteriaPlaceholder && (
                  <div style="border-top:1px dashed var(--line-strong);padding-top:1rem;margin-top:1.5rem">
                    <span class="label" style="display:block;margin-bottom:.3rem">Judging Framework</span>
                    <span class="ph" style="font-size:.85rem">{theme.criteriaPlaceholder}</span>
                  </div>
                )}
              </div>

              <!-- SVG Geometric Visualization -->
              <div
                style="aspect-ratio:1;border:1px solid var(--line);background:var(--bg);display:grid;place-items:center;padding:1.5rem"
                aria-hidden="true"
              >
                {theme.svgShape === 'concentric' && (
                  <svg viewBox="0 0 200 200" fill="none" stroke="#C8FF2E" stroke-width="1" width="100%" height="100%">
                    <circle cx="100" cy="100" r="85" stroke="rgba(242,238,230,.2)" />
                    <circle cx="100" cy="100" r="60" stroke="#C8FF2E" />
                    <circle cx="100" cy="100" r="35" stroke="rgba(242,238,230,.5)" />
                    <circle cx="100" cy="100" r="10" stroke="rgba(242,238,230,.8)" />
                    <line x1="15" y1="100" x2="185" y2="100" stroke="rgba(242,238,230,.2)" />
                    <line x1="100" y1="15" x2="100" y2="185" stroke="rgba(242,238,230,.2)" />
                    <circle cx="100" cy="100" r="4" fill="#C8FF2E" stroke="none" />
                  </svg>
                )}
                {theme.svgShape === 'flow' && (
                  <svg viewBox="0 0 200 200" fill="none" stroke="#C8FF2E" stroke-width="1" width="100%" height="100%">
                    <g stroke="rgba(242,238,230,.35)">
                      <path d="M0 30 Q100 80 200 30" />
                      <path d="M0 70 Q100 120 200 70" />
                      <path d="M0 110 Q100 160 200 110" />
                      <path d="M0 150 Q100 200 200 150" />
                    </g>
                    <path d="M40 0 Q 60 100 40 200" stroke="rgba(242,238,230,.25)" />
                    <path d="M100 0 Q 120 100 100 200" stroke="#C8FF2E" stroke-width="1.5" />
                    <path d="M160 0 Q 140 100 160 200" stroke="rgba(242,238,230,.25)" />
                    <circle cx="100" cy="100" r="4" fill="#C8FF2E" stroke="none" />
                  </svg>
                )}
                {theme.svgShape === 'triangle' && (
                  <svg viewBox="0 0 200 200" fill="none" stroke="#C8FF2E" stroke-width="1" width="100%" height="100%">
                    <polygon points="100,15 185,165 15,165" stroke="#C8FF2E" stroke-width="1.2" />
                    <polygon points="100,55 155,145 45,145" stroke="rgba(242,238,230,.5)" />
                    <polygon points="100,90 125,130 75,130" stroke="rgba(242,238,230,.25)" />
                    <line x1="100" y1="15" x2="100" y2="185" stroke="rgba(242,238,230,.2)" />
                    <line x1="15" y1="165" x2="185" y2="165" stroke="rgba(242,238,230,.2)" />
                    <circle cx="100" cy="115" r="4" fill="#C8FF2E" stroke="none" />
                  </svg>
                )}
                {theme.svgShape === 'squares' && (
                  <svg viewBox="0 0 200 200" fill="none" stroke="#C8FF2E" stroke-width="1" width="100%" height="100%">
                    <rect x="35" y="35" width="130" height="130" transform="rotate(12 100 100)" stroke="rgba(242,238,230,.35)" />
                    <rect x="55" y="55" width="90" height="90" transform="rotate(-18 100 100)" stroke="#C8FF2E" stroke-width="1.2" />
                    <rect x="75" y="75" width="50" height="50" stroke="rgba(242,238,230,.6)" />
                    <circle cx="100" cy="100" r="5" fill="#C8FF2E" stroke="none" />
                  </svg>
                )}
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Section: Track Bounties & Schedule Note -->
  <section class="section" aria-labelledby="prizes-heading">
    <div class="wrap">
      <div style="border:1px solid var(--line);padding:2.5rem;background:var(--bg-2)">
        <span class="idx" style="display:block;margin-bottom:.5rem">Prize Pools &amp; Partner Challenges</span>
        <h2 id="prizes-heading" style="font-size:clamp(1.4rem,2.5vw,2rem);font-weight:700;margin:0 0 1rem">
          {THEMES_NOTE.prizeStatus}
        </h2>
        <p class="body" style="margin:0 0 1.8rem">
          Sponsor-specific challenge tracks, specialized API tool grants, and cash prize pool distributions will be officially announced alongside verified partner sponsorships.
        </p>
        <div style="display:flex;gap:1rem;flex-wrap:wrap">
          <a href="/roadmap/" class="btn btn-ghost">
            View Release Roadmap <span class="arrow">→</span>
          </a>
          <a href={EVENT_CONFIG.registration.url} class="btn btn-primary">
            {EVENT_CONFIG.registration.buttonText} <span class="arrow">→</span>
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  @media (max-width: 860px) {
    article > div:nth-child(2) {
      grid-template-columns: 1fr !important;
    }
  }
</style>
