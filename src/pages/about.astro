---
import Layout from '../layouts/Layout.astro';
import About from '../components/About.astro';
import Cta from '../components/Cta.astro';
import PageHeader from '../components/PageHeader.astro';
import { EVENT_CONFIG } from '../data/event';

const pageTitle = `About · ${EVENT_CONFIG.name} ${EVENT_CONFIG.edition} · ${EVENT_CONFIG.organizer} PESU`;
const pageDescription = `Learn about ${EVENT_CONFIG.name} ${EVENT_CONFIG.edition} — the flagship hackathon of ${EVENT_CONFIG.organizer} at ${EVENT_CONFIG.university}, ${EVENT_CONFIG.city}. Explore our engineering-first manifesto, interdisciplinary ethos, and convergence philosophy.`;
---

<Layout title={pageTitle} description={pageDescription}>
  <!-- Page Header -->
  <PageHeader
    index="01 — About"
    label="Manifesto · Purpose · Convergence"
    supertitle={`${EVENT_CONFIG.organizer} · ${EVENT_CONFIG.university}`}
    title="Engineering"
    titleOutline="Convergence"
    titleId="about-page-title"
  >
    <p class="lede reveal" style="--d:.1s;margin:0">
      A flagship gathering engineered for builders, systems thinkers, and researchers who believe the most compelling ideas happen where disciplines intersect.
    </p>
  </PageHeader>

  <!-- Core Manifesto Section (Shared Reusable Component) -->
  <About />

  <!-- Detailed Chapter & Environment Section -->
  <section class="section" aria-labelledby="ethos-title">
    <div class="wrap">
      <div class="section-head reveal">
        <span class="idx">Context</span>
        <span class="label">Host Institution · Organizing Committee</span>
      </div>

      <h2 class="h2 reveal" id="ethos-title" style="margin:0 0 clamp(2rem, 4vw, 3rem);font-size:clamp(2rem, 4.5vw, 3.8rem);line-height:1">
        Host &amp; <span class="outline-text">Community</span>
      </h2>

      <div style="display:grid;grid-template-columns:repeat(auto-fit, minmax(min(100%, 360px), 1fr));gap:clamp(2rem, 5vw, 4rem)">
        <div class="reveal" style="border:1px solid var(--line);background:var(--bg-2);padding:clamp(2rem, 4vw, 3rem)">
          <span class="label" style="display:block;margin-bottom:1rem">Host Chapter</span>
          <h3 class="display" style="font-size:clamp(1.8rem, 3.5vw, 2.8rem);line-height:1;margin:0 0 1.2rem">
            {EVENT_CONFIG.organizer}
          </h3>
          <p class="body" style="margin:0 0 1.2rem">
            The {EVENT_CONFIG.organizer} at {EVENT_CONFIG.university} stands as a student-led community committed to technical rigour, practical engineering, and collaborative systems innovation.
          </p>
          <div class="label" style="border-top:1px solid var(--line);padding-top:1rem;color:var(--muted);display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:.6rem">
            <span>{EVENT_CONFIG.university} · {EVENT_CONFIG.city}</span>
            <a href="https://www.instagram.com/ieee.cs.pesu" target="_blank" rel="noopener noreferrer" style="color:var(--acid);text-decoration:none">@ieee.cs.pesu ↗</a>
          </div>
        </div>

        <div class="reveal" style="--d:.1s;border:1px solid var(--line);background:var(--bg-2);padding:clamp(2rem, 4vw, 3rem)">
          <span class="label" style="display:block;margin-bottom:1rem">Participant Philosophy</span>
          <h3 class="display" style="font-size:clamp(1.8rem, 3.5vw, 2.8rem);line-height:1;margin:0 0 1.2rem">
            Craft Over <span class="outline-text">Slides</span>
          </h3>
          <p class="body" style="margin:0 0 1.2rem">
            Confluence rewards working prototypes over speculative decks. Whether compiling embedded kernels, coordinating agent pipelines, or verifying distributed states, execution depth remains the primary criterion.
          </p>
          <div class="label" style="border-top:1px solid var(--line);padding-top:1rem;color:var(--muted)">
            Venue: <span style="color:var(--ink);font-weight:600">{EVENT_CONFIG.eventDetails.venueText}</span>
          </div>
        </div>
      </div>

      <!-- Auditorium & Stage Demos Showcase -->
      <div class="reveal" style="margin-top:clamp(2.5rem, 5vw, 4rem);border:1px solid var(--line);background:var(--bg-2);overflow:hidden">
        <div style="position:relative;width:100%;height:clamp(340px, 40vw, 500px);overflow:hidden">
          <picture style="width:100%;height:100%;display:block">
            <source srcset="/images/stage-demos.webp" type="image/webp" />
            <img
              src="/images/stage-demos.jpg"
              alt="Confluence Hackathon Grand Finale live prototype demonstrations before jury and audience at PES University auditorium"
              style="width:100%;height:100%;object-fit:cover;object-position:center 30%;display:block;filter:contrast(1.05) brightness(0.94)"
              loading="lazy"
              decoding="async"
              width="1376"
              height="768"
            />
          </picture>
          <div style="position:absolute;inset:0;background:linear-gradient(180deg, rgba(10,10,10,0.1) 0%, rgba(10,10,10,0.85) 100%)"></div>
          
          <div style="position:absolute;top:1.5rem;left:1.5rem">
            <span class="label" style="background:rgba(10,10,10,0.85);backdrop-filter:blur(8px);border:1px solid var(--acid);color:var(--acid)">
              ● Grand Finale Stage
            </span>
          </div>

          <div style="position:absolute;bottom:1.5rem;left:1.5rem;right:1.5rem;display:flex;justify-content:space-between;align-items:flex-end;flex-wrap:wrap;gap:1rem">
            <div>
              <p class="label" style="margin:0 0 .3rem;color:var(--muted)">Evaluation &amp; Presentation</p>
              <h3 style="font-family:var(--display);font-size:clamp(1.2rem, 2.2vw, 1.8rem);font-weight:600;margin:0;color:var(--ink)">
                Live System Demonstrations Before Industry Jury
              </h3>
            </div>
            <span class="coords" style="color:#BDB9AF;background:rgba(10,10,10,0.7);padding:.3rem .6rem">
              G.J. Auditorium · PESU
            </span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <Cta />
</Layout>
