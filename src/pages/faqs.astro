---
import Layout from '../layouts/Layout.astro';
import Faq from '../components/Faq.astro';
import Cta from '../components/Cta.astro';
import PageHeader from '../components/PageHeader.astro';
import { EVENT_CONFIG } from '../data/event';

const pageTitle = `Frequently Asked Questions · ${EVENT_CONFIG.name} ${EVENT_CONFIG.edition}`;
const pageDescription = `Find answers to common questions about ${EVENT_CONFIG.name} ${EVENT_CONFIG.edition}. Eligibility, team sizes, registration process, theme announcements, and format details for the flagship hackathon in ${EVENT_CONFIG.city}.`;
---

<Layout title={pageTitle} description={pageDescription}>
  <!-- Page Header -->
  <PageHeader
    index="04 — FAQs"
    label="Questions · Answers · Policies"
    supertitle={`Edition ${EVENT_CONFIG.edition} · Participant Guidance`}
    title="Frequently"
    titleOutline="Answered"
    titleId="faqs-page-title"
  >
    <div style="max-width:44ch">
      <p class="lede reveal" style="--d:.1s;margin:0 0 1.2rem">
        Everything you need to know about team eligibility, registration prerequisites, problem track releases, and submission expectations.
      </p>
      <div class="label reveal" style="--d:.15s;border-left:2px solid var(--acid);padding-left:1rem;color:var(--ink)">
        Verified Rules &amp; Hackathon Participant Guidance
      </div>
    </div>
  </PageHeader>

  <!-- Core FAQs Accordion (Shared Reusable Component) -->
  <Faq />

  <!-- Organizer Contact & Inquiries Card -->
  <section class="section grid-lines-x" aria-labelledby="inquiry-title">
    <div class="wrap">
      <div class="section-head reveal">
        <span class="idx">Support</span>
        <span class="label">Further Inquiries</span>
      </div>

      <div style="display:flex;justify-content:space-between;align-items:flex-end;margin-bottom:2.5rem;flex-wrap:wrap;gap:1.5rem">
        <div>
          <h2 class="h2 reveal" id="inquiry-title" style="margin:0;font-size:clamp(2rem, 4vw, 3rem)">
            Direct <span class="outline-text">Assistance</span>
          </h2>
        </div>
        <p class="body reveal" style="max-width:44ch;margin:0">
          Official support desks, institutional inquiries, and venue liaison details.
        </p>
      </div>

      <div style="display:grid;grid-template-columns:repeat(auto-fit, minmax(min(100%, 360px), 1fr));gap:2.5rem">
        <div class="reveal" style="border:1px solid var(--line);background:var(--bg-2);padding:clamp(2rem, 4vw, 3rem)">
          <span class="label" style="display:block;margin-bottom:.8rem">Direct Assistance</span>
          <h3 class="display" style="font-size:1.6rem;margin:0 0 1rem">Have an Unanswered Question?</h3>
          <p class="body" style="margin:0 0 1.5rem">
            Official rules, eligibility tiers, and challenge guidelines are confirmed through the {EVENT_CONFIG.organizer} PESU committee. For institutional inquiries, reach out through our contact desk.
          </p>
          <div style="display:flex;gap:1.2rem;flex-wrap:wrap;align-items:center">
            <div class="label" style="color:var(--acid)">
              Desk Email · <a href={`mailto:${EVENT_CONFIG.contact.email}`} style="color:var(--acid);text-decoration:none">{EVENT_CONFIG.contact.email}</a>
            </div>
            <div class="label" style="color:var(--acid)">
              WhatsApp · <a href="https://chat.whatsapp.com/FktQhy24FNyDdAq2ZfNmm2" target="_blank" rel="noopener noreferrer" style="color:var(--acid);text-decoration:none">Group ↗</a>
            </div>
            <div class="label" style="color:var(--acid)">
              Discord · <a href="https://discord.com/invite/7kpmFp2uuU" target="_blank" rel="noopener noreferrer" style="color:var(--acid);text-decoration:none">Community ↗</a>
            </div>
            <div class="label" style="color:var(--acid)">
              GitHub · <a href="https://github.com/IEEE-CS-PESU" target="_blank" rel="noopener noreferrer" style="color:var(--acid);text-decoration:none">IEEE-CS-PESU ↗</a>
            </div>
            <div class="label" style="color:var(--acid)">
              Instagram · <a href="https://www.instagram.com/ieee.cs.pesu" target="_blank" rel="noopener noreferrer" style="color:var(--acid);text-decoration:none">@ieee.cs.pesu ↗</a>
            </div>
            <div class="label" style="color:var(--acid)">
              LinkedIn · <a href="https://www.linkedin.com/company/ieeecspesu/home" target="_blank" rel="noopener noreferrer" style="color:var(--acid);text-decoration:none">IEEE CS PESU ↗</a>
            </div>
          </div>
        </div>

        <div class="reveal" style="--d:.1s;border:1px solid var(--line);background:var(--bg-2);padding:clamp(2rem, 4vw, 3rem)">
          <span class="label" style="display:block;margin-bottom:.8rem">Location & Campus</span>
          <h3 class="display" style="font-size:1.6rem;margin:0 0 1rem">Venue Information</h3>
          <p class="body" style="margin:0 0 1.5rem">
            Confluence 2026 will be hosted in-person at {EVENT_CONFIG.university}, {EVENT_CONFIG.city}. Room assignments, lab coordinates, and badge collection desks will be announced prior to hack day.
          </p>
          <div class="label" style="color:var(--acid)">
            Campus · <span style="color:var(--ink);font-weight:600">{EVENT_CONFIG.eventDetails.venueText}</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <Cta />
</Layout>
