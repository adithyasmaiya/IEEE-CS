---
import { NAV_ITEMS } from '../data/navigation';
import { EVENT_CONFIG } from '../data/event';

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header class="nav" id="top">
  <div class="nav-inner">
    <a href="/" class="wordmark" aria-label={`${EVENT_CONFIG.name} ${EVENT_CONFIG.edition} home`}>
      {EVENT_CONFIG.name}<sup>/{EVENT_CONFIG.edition.slice(-2)}</sup>
    </a>
    <span class="nav-id">IEEE CS · PESU</span>
    
    <nav aria-label="Primary">
      <ul class="nav-links">
        {NAV_ITEMS.map((item) => {
          const itemPath = item.href.replace(/\/$/, '') || '/';
          const isActive = currentPath === itemPath;
          return (
            <li>
              <a
                href={item.href}
                class={isActive ? 'active' : undefined}
                aria-current={isActive ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          );
        })}
      </ul>
    </nav>

    <div style="display:flex;align-items:center;gap:.75rem">
      <a href={EVENT_CONFIG.registration.url} class="btn btn-primary nav-cta">
        {EVENT_CONFIG.registration.buttonText} <span class="arrow" aria-hidden="true">→</span>
      </a>
      <button
        class="menu-btn"
        id="menuBtn"
        type="button"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobileMenu"
      >
        <span></span>
        <span></span>
      </button>
    </div>
  </div>
</header>

<div class="mobile-menu" id="mobileMenu" aria-hidden="true">
  <ul>
    {NAV_ITEMS.map((item) => {
      const itemPath = item.href.replace(/\/$/, '') || '/';
      const isActive = currentPath === itemPath;
      return (
        <li>
          <a
            href={item.href}
            data-close
            class={isActive ? 'active' : undefined}
            aria-current={isActive ? 'page' : undefined}
          >
            {item.label} <span>{item.index}</span>
          </a>
        </li>
      );
    })}
  </ul>
  <div>
    <a
      href={EVENT_CONFIG.registration.url}
      class="btn btn-primary"
      data-close
      style="width:100%;justify-content:space-between"
    >
      {EVENT_CONFIG.registration.buttonText} <span class="arrow" aria-hidden="true">→</span>
    </a>
    <p class="label" style="margin:1.2rem 0 0">
      {EVENT_CONFIG.organizer} · {EVENT_CONFIG.university} · {EVENT_CONFIG.city}
    </p>
  </div>
</div>
