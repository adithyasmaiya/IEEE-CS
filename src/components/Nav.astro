---
import { NAV_ITEMS } from '../data/navigation';
import { EVENT_CONFIG } from '../data/event';

const { registration } = EVENT_CONFIG;
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header class="nav">
  <div class="nav-inner">
    <a href="/" class="nav-brand" aria-label={`${EVENT_CONFIG.name} ${EVENT_CONFIG.edition} home`}>
      <img
        src="/images/ieee-cs-pesu-logo.png"
        alt="IEEE Computer Society - PES University Student Branch Chapter"
        class="nav-logo-img"
        width="240"
        height="92"
        loading="eager"
        decoding="async"
      />
    </a>

    <nav aria-label="Primary">
      <ul class="nav-links">
        {NAV_ITEMS.map((item) => {
          const itemPath = item.href.replace(/\/$/, '') || '/';
          const isActive = currentPath === itemPath;
          return (
            <li>
              <a
                href={item.href}
                class={isActive ? 'active' : undefined}
                aria-current={isActive ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          );
        })}
      </ul>
    </nav>

    <div style="display:flex;align-items:center;gap:.75rem">
      {registration.isOpen ? (
        <a
          href="/register/"
          class="btn btn-primary nav-cta"
          data-hover
        >
          {registration.buttonText} <span class="arrow">→</span>
        </a>
      ) : (
        <a
          href="/register/"
          class="btn btn-ghost nav-cta"
          data-hover
          style="opacity:.85;border-style:dashed"
          title="Registration is currently closed"
        >
          {registration.unavailableBadgeText} <span class="arrow">→</span>
        </a>
      )}

      <button
        class="menu-btn"
        id="menuBtn"
        type="button"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobileMenu"
      >
        <span></span>
        <span></span>
      </button>
    </div>
  </div>
</header>

<div class="mobile-menu" id="mobileMenu" aria-hidden="true">
  <ul>
    {NAV_ITEMS.map((item) => {
      const itemPath = item.href.replace(/\/$/, '') || '/';
      const isActive = currentPath === itemPath;
      return (
        <li>
          <a
            href={item.href}
            data-close
            class={isActive ? 'active' : undefined}
            aria-current={isActive ? 'page' : undefined}
          >
            {item.label} <span>{item.index}</span>
          </a>
        </li>
      );
    })}
  </ul>
  <div>
    {registration.isOpen ? (
      <a
        href="/register/"
        class="btn btn-primary"
        data-close
        style="width:100%;justify-content:space-between"
      >
        {registration.buttonText} <span class="arrow">→</span>
      </a>
    ) : (
      <a
        href="/register/"
        class="btn btn-ghost"
        data-close
        style="width:100%;justify-content:space-between;border-style:dashed"
      >
        {registration.unavailableText} <span class="arrow">→</span>
      </a>
    )}
    <p class="label" style="margin:1.2rem 0 0">
      {EVENT_CONFIG.organizer} · {EVENT_CONFIG.university} · {EVENT_CONFIG.city}
    </p>
  </div>
</div>
