---
// src/components/HeroAnimation.astro
// Ultra-optimized, zero-lag canvas-based frame renderer for Confluence 2026 hero animation
---

<div class="hero-character-wrap" id="heroCharWrap" aria-hidden="true">
  <canvas
    id="heroCanvas"
    class="hero-character-canvas"
    width="1920"
    height="1080"
  ></canvas>
</div>

<script>
  (() => {
    class HeroAnimationPlayer {
      private canvas: HTMLCanvasElement | null = null;
      private ctx: CanvasRenderingContext2D | null = null;
      private readonly totalFrames = 177;
      private readonly fps = 24;
      private readonly frameDuration = 1000 / this.fps; // 41.666... ms
      private readonly bufferRunway = 20; // Pre-buffer 20 frames (~833ms) before starting playback
      private readonly pauseDuration = 1200; // 1.2s celebration hold on Eureka triumph frame
      private readonly concurrency = 8; // Parallel streaming requests

      private currentFrame = 0;
      private images: (HTMLImageElement | null)[] = [];
      private loadedCount = 0;
      private isPlaying = false;
      private isStarted = false;
      private rafId: number | null = null;
      private lastFrameTime = 0;
      private accumulator = 0;
      private pauseStartTime = 0;
      private isHoldingEureka = false;
      private isVisible = true;
      private reduceMotion = false;

      constructor(canvasId: string) {
        this.canvas = document.getElementById(canvasId) as HTMLCanvasElement | null;
        if (!this.canvas) return;

        // Acquire context with performance flags
        this.ctx = this.canvas.getContext('2d', { alpha: true });
        if (!this.ctx) return;

        // Direct 1:1 blit optimization (avoid bilinear scaling cost on 1080p canvas)
        this.ctx.imageSmoothingEnabled = false;

        this.images = new Array(this.totalFrames).fill(null);
        this.reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        this.init();
      }

      private getFrameUrl(index: number, format: 'webp' | 'jpg' = 'webp'): string {
        const num = String(index + 1).padStart(3, '0');
        return `/frames/ezgif-frame-${num}.${format}`;
      }

      /**
       * Asynchronously load and off-thread decode a single frame.
       * Uses img.decode() to eliminate main-thread jank when ctx.drawImage is called.
       */
      private async loadSingleFrame(index: number): Promise<HTMLImageElement | null> {
        if (this.images[index]) return this.images[index];

        const tryDecode = (format: 'webp' | 'jpg'): Promise<HTMLImageElement> => {
          return new Promise((resolve, reject) => {
            const img = new Image();
            img.src = this.getFrameUrl(index, format);

            if ('decode' in img && typeof img.decode === 'function') {
              img.decode()
                .then(() => resolve(img))
                .catch(() => {
                  img.onload = () => resolve(img);
                  img.onerror = () => reject(new Error(`Failed to load ${format}`));
                });
            } else {
              img.onload = () => resolve(img);
              img.onerror = () => reject(new Error(`Failed to load ${format}`));
            }
          });
        };

        try {
          const img = await tryDecode('webp');
          this.images[index] = img;
          this.loadedCount++;
          return img;
        } catch {
          try {
            const fallback = await tryDecode('jpg');
            this.images[index] = fallback;
            this.loadedCount++;
            return fallback;
          } catch {
            return null;
          }
        }
      }

      private async init(): Promise<void> {
        if (!this.ctx || !this.canvas) return;

        // If user prefers reduced motion, render static celebratory Eureka frame without animation loop
        if (this.reduceMotion) {
          const staticImg = (await this.loadSingleFrame(159)) || (await this.loadSingleFrame(0));
          if (staticImg && this.ctx && this.canvas) {
            this.ctx.drawImage(staticImg, 0, 0, this.canvas.width, this.canvas.height);
          }
          return;
        }

        // STEP 1: Preload and decode Frame 0 immediately for instant paint
        const firstFrame = await this.loadSingleFrame(0);
        if (firstFrame && this.ctx && this.canvas) {
          this.ctx.drawImage(firstFrame, 0, 0, this.canvas.width, this.canvas.height);
        }

        // STEP 2: Start prioritized background streaming
        this.startStreamingPreload();

        // STEP 3: Setup intersection and visibility listeners
        this.setupObservers();
      }

      /**
       * High-throughput progressive frame streamer with buffer runway.
       * Preloads frames ahead of playhead so playback never stalls or skips.
       */
      private startStreamingPreload(): void {
        let nextIndexToFetch = 1;
        let activeLoads = 0;

        const checkBufferAndStart = () => {
          if (!this.isStarted && this.loadedCount >= this.bufferRunway) {
            this.isStarted = true;
            if (this.isVisible && !this.reduceMotion) {
              this.start();
            }
          }
        };

        const pump = () => {
          while (activeLoads < this.concurrency && nextIndexToFetch < this.totalFrames) {
            const idx = nextIndexToFetch++;
            activeLoads++;

            this.loadSingleFrame(idx).then(() => {
              activeLoads--;
              checkBufferAndStart();
              pump();
            });
          }
        };

        // Safety fallback: begin playback after 1000ms if on slower network and initial runway reached
        setTimeout(() => {
          if (!this.isStarted && this.loadedCount >= 4) {
            this.isStarted = true;
            if (this.isVisible && !this.reduceMotion) {
              this.start();
            }
          }
        }, 1000);

        pump();
      }

      private setupObservers(): void {
        const hero = document.getElementById('hero');
        if (hero && 'IntersectionObserver' in window) {
          const observer = new IntersectionObserver(
            (entries) => {
              entries.forEach((entry) => {
                this.isVisible = entry.isIntersecting;
                if (this.isVisible && !this.isPlaying && this.isStarted && !this.reduceMotion) {
                  this.start();
                } else if (!this.isVisible && this.isPlaying) {
                  this.stop();
                }
              });
            },
            { threshold: 0.05 }
          );
          observer.observe(hero);
        }

        // Save CPU/battery when tab is hidden
        document.addEventListener('visibilitychange', () => {
          if (document.hidden) {
            this.stop();
          } else if (this.isVisible && this.isStarted && !this.reduceMotion) {
            this.start();
          }
        });

        // Dynamic reduced motion toggle
        window.matchMedia('(prefers-reduced-motion: reduce)').addEventListener('change', (e) => {
          this.reduceMotion = e.matches;
          if (this.reduceMotion) {
            this.stop();
            const fallback = this.images[159] || this.images[0];
            if (fallback && this.ctx && this.canvas) {
              this.ctx.drawImage(fallback, 0, 0, this.canvas.width, this.canvas.height);
            }
          } else if (this.isVisible && this.isStarted) {
            this.start();
          }
        });
      }

      private start(): void {
        if (this.isPlaying || this.reduceMotion) return;
        this.isPlaying = true;
        this.lastFrameTime = performance.now();
        this.accumulator = 0;
        this.rafId = requestAnimationFrame((ts) => this.tick(ts));
      }

      private stop(): void {
        this.isPlaying = false;
        if (this.rafId !== null) {
          cancelAnimationFrame(this.rafId);
          this.rafId = null;
        }
      }

      /**
       * Ultra-smooth fixed-cadence animation loop with underrun protection.
       * Eliminates frame drops and jitter by pacing to strict 24fps film time.
       */
      private tick(now: number): void {
        if (!this.isPlaying) return;

        this.rafId = requestAnimationFrame((ts) => this.tick(ts));

        // Eureka triumph hold at the end of the sequence
        if (this.isHoldingEureka) {
          if (now - this.pauseStartTime >= this.pauseDuration) {
            this.isHoldingEureka = false;
            this.currentFrame = 0;
            this.lastFrameTime = now;
            this.accumulator = 0;
            this.draw();
          }
          return;
        }

        let delta = now - this.lastFrameTime;

        // Guard against massive delta spikes (e.g. tab suspend / heavy background work)
        if (delta > 250) {
          delta = this.frameDuration;
          this.lastFrameTime = now - this.frameDuration;
        }

        this.accumulator += delta;
        this.lastFrameTime = now;

        let shouldRedraw = false;

        // Fixed-timestep accumulator loop for 24fps pacing
        while (this.accumulator >= this.frameDuration) {
          this.accumulator -= this.frameDuration;

          // Reached final celebratory frame: initiate hold
          if (this.currentFrame >= this.totalFrames - 1) {
            this.isHoldingEureka = true;
            this.pauseStartTime = now;
            shouldRedraw = true;
            break;
          }

          const nextIndex = this.currentFrame + 1;

          // Underrun protection: only advance if the next frame has finished decoding
          if (this.images[nextIndex]) {
            this.currentFrame = nextIndex;
            shouldRedraw = true;
          } else {
            // Next frame is still decoding: pause accumulator to hold current frame smoothly
            this.accumulator = 0;
            break;
          }
        }

        if (shouldRedraw) {
          this.draw();
        }
      }

      /**
       * Direct hardware blit without redundant clearRect calls.
       */
      private draw(): void {
        if (!this.ctx || !this.canvas) return;
        const img = this.images[this.currentFrame];
        if (img) {
          this.ctx.drawImage(img, 0, 0, this.canvas.width, this.canvas.height);
        }
      }
    }

    // Initialize player when DOM is ready
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', () => new HeroAnimationPlayer('heroCanvas'));
    } else {
      new HeroAnimationPlayer('heroCanvas');
    }
  })();
</script>
