---
import { EVENT_CONFIG } from '../data/event';
---

<section class="section final" id="register" aria-labelledby="final-title">
  <div class="final-art" aria-hidden="true">
    <svg viewBox="0 0 800 800" width="100%" height="100%" fill="none" stroke="#C8FF2E" stroke-width="1">
      <g class="orbit-ring slow">
        <ellipse cx="400" cy="400" rx="380" ry="150" />
        <ellipse cx="400" cy="400" rx="380" ry="150" transform="rotate(60 400 400)" />
        <ellipse cx="400" cy="400" rx="380" ry="150" transform="rotate(120 400 400)" />
      </g>
      <circle cx="400" cy="400" r="250" stroke="rgba(242,238,230,.12)" stroke-dasharray="2 6" />
      <circle cx="400" cy="400" r="6" fill="#C8FF2E" stroke="none" />
    </svg>
  </div>

  <div class="wrap final-inner">
    <div class="section-head reveal" style="border-top:0">
      <span class="idx">05 — Join</span>
      <span class="label">Build Together · {EVENT_CONFIG.city}</span>
    </div>

    <h2 class="final-word reveal" id="final-title" aria-label={`${EVENT_CONFIG.name} ${EVENT_CONFIG.edition}`}>
      {EVENT_CONFIG.name}<br />
      <span class="outline-text">/{EVENT_CONFIG.edition.slice(-2)}</span>
    </h2>

    <div class="final-bottom">
      <h3 class="reveal">
        Bring an idea. Bring a discipline. Leave with something that works.
      </h3>
      <div class="final-cta reveal" style="--d:.15s">
        <a href={EVENT_CONFIG.registration.url} class="btn btn-primary">
          {EVENT_CONFIG.registration.buttonText} <span class="arrow" aria-hidden="true">→</span>
        </a>
        <span class="label">
          Registration opens <span class="ph">{EVENT_CONFIG.registration.openDateText}</span>
        </span>
      </div>
    </div>
  </div>
</section>
