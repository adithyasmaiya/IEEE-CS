---
import { EVENT_CONFIG } from '../data/event';
const { manifesto } = EVENT_CONFIG;
---

<section class="section grid-lines-x" id="about" aria-labelledby="about-title">
  <div class="wrap">
    <div class="section-head reveal">
      <span class="idx">01 — About</span>
      <span class="label">Manifesto / Purpose</span>
    </div>

    <div class="manifesto-grid">
      <h2 class="manifesto-statement" id="about-title">
        <span class="reveal" style="display:block">Ideas are</span>
        <span class="reveal" style="--d:.1s;display:block"><span class="dim">cheap.</span> Engineering</span>
        <span class="reveal" style="--d:.2s;display:block">is <span class="acid">where</span> they</span>
        <span class="reveal" style="--d:.3s;display:block">meet <span class="dim">the</span> world.</span>
      </h2>

      <div class="manifesto-cols reveal" style="--d:.1s">
        <p class="lede">
          {manifesto.lede}
        </p>
        {manifesto.paragraphs.map((p) => (
          <p class="body">{p}</p>
        ))}
      </div>

      <div class="manifesto-side">
        <div class="manifesto-art reveal" style="--d:.2s" aria-label="Engineers prototyping circuits and edge AI at Confluence">
          <picture class="manifesto-pic">
            <source srcset="/images/convergence-lab.webp" type="image/webp" />
            <img
              src="/images/convergence-lab.jpg"
              alt="Engineering students prototyping embedded edge AI systems, microcontroller circuits, and oscilloscopes at Confluence Hackathon"
              class="manifesto-img"
              loading="lazy"
              decoding="async"
              width="900"
              height="1200"
            />
          </picture>
          <div class="manifesto-art-overlay" aria-hidden="true"></div>
          
          <div class="manifesto-art-top">
            <span class="label" style="background:rgba(10,10,10,0.85);backdrop-filter:blur(8px);border:1px solid var(--line);color:var(--ink);font-size:0.7rem;padding:.3rem .6rem">
              PESU Engineering Labs
            </span>
            <span class="coords" style="color:var(--acid);background:rgba(10,10,10,0.85);backdrop-filter:blur(8px);padding:.3rem .6rem;border:1px solid rgba(200,255,46,0.3);font-size:0.7rem">
              HW × ML Pod
            </span>
          </div>
        </div>

        <ol class="manifesto-list reveal" style="--d:.25s;list-style:none">
          {manifesto.pillars.map((pillar) => (
            <li>
              <span class="idx">{pillar.index}</span>
              <div>
                <strong>{pillar.title}</strong>
                <span>{pillar.description}</span>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </div>
</section>

<style>
  .manifesto-art {
    position: relative;
    border: 1px solid var(--line);
    background: var(--bg-2);
    overflow: hidden;
  }

  .manifesto-pic {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }

  .manifesto-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 30%;
    display: block;
    filter: contrast(1.06) brightness(0.92);
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .manifesto-art:hover .manifesto-img {
    transform: scale(1.03);
  }

  .manifesto-art-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(10,10,10,0.45) 0%, rgba(10,10,10,0) 25%),
                linear-gradient(0deg, rgba(10,10,10,0.85) 0%, rgba(10,10,10,0.3) 35%, transparent 100%);
    pointer-events: none;
  }

  .manifesto-art-top {
    position: absolute;
    top: 1rem;
    left: 1rem;
    right: 1rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.6rem;
    z-index: 2;
  }
</style>
