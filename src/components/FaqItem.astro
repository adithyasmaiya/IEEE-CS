---
// src/components/FaqItem.astro — Reusable FAQ accordion item component
import type { FaqItem as FaqType } from '../types';

interface Props {
  item: FaqType;
}

const { item } = Astro.props;
---

<details class="faq reveal" open={item.defaultOpen}>
  <summary>
    <span class="q-idx">{item.index}</span>
    <span>{item.question}</span>
    <span class="toggle" aria-hidden="true"></span>
  </summary>
  <div class="answer">
    <p>{item.answerText}</p>
    {item.placeholderDetail && (
      <span class="ph">{item.placeholderDetail}</span>
    )}
  </div>
</details>
