---
import { THEMES_LIST, THEMES_NOTE } from '../data/themes';
---

<section class="section" id="themes" aria-labelledby="themes-title">
  <div class="wrap">
    <div class="section-head reveal">
      <span class="idx">02 — Themes</span>
      <span class="label">Problem Spaces · 2026</span>
    </div>

    <div style="display:flex;justify-content:space-between;align-items:end;gap:2rem;flex-wrap:wrap;margin-bottom:3rem">
      <h2 class="h2 reveal" id="themes-title" style="margin:0">
        Four<br />fields.<br /><span class="outline-text">One</span> system.
      </h2>
      <p class="body reveal" style="--d:.1s;margin:0">
        Theme titles and briefs below are placeholders until the official 2026 problem statements are announced. Hover or focus a row to preview its visual language.
      </p>
    </div>

    <div class="themes-list">
      {THEMES_LIST.map((theme, idx) => (
        <article class="theme reveal" style={`--d:${idx * 0.05}s`} tabindex="0">
          <span class="theme-num">{theme.number}</span>
          <div>
            <h3 class="theme-title">
              {theme.title}{' '}
              {theme.isPlaceholderTitle && (
                <span class="ph" style="font-size:.3em;vertical-align:middle">[TBA]</span>
              )}
            </h3>
          </div>
          <p class="theme-desc">
            {theme.description}
            <span class="tag label">{theme.trackTag}</span>
          </p>
          <span class="theme-arrow" aria-hidden="true">↗</span>
          
          <div class="theme-visual" aria-hidden="true">
            {theme.svgShape === 'concentric' && (
              <svg viewBox="0 0 200 200" fill="none" stroke="#C8FF2E" stroke-width="1" width="100%" height="100%">
                <circle cx="100" cy="100" r="80" stroke="rgba(242,238,230,.2)" />
                <circle cx="100" cy="100" r="55" />
                <circle cx="100" cy="100" r="30" stroke="rgba(242,238,230,.5)" />
                <line x1="20" y1="100" x2="180" y2="100" stroke="rgba(242,238,230,.2)" />
                <line x1="100" y1="20" x2="100" y2="180" stroke="rgba(242,238,230,.2)" />
                <circle cx="100" cy="100" r="3" fill="#C8FF2E" stroke="none" />
              </svg>
            )}
            {theme.svgShape === 'flow' && (
              <svg viewBox="0 0 200 200" fill="none" stroke="#C8FF2E" stroke-width="1" width="100%" height="100%">
                <g stroke="rgba(242,238,230,.35)">
                  <path d="M0 30 Q100 80 200 30" />
                  <path d="M0 70 Q100 120 200 70" />
                  <path d="M0 110 Q100 160 200 110" />
                  <path d="M0 150 Q100 200 200 150" />
                </g>
                <path d="M40 0 Q 60 100 40 200" stroke="rgba(242,238,230,.25)" />
                <path d="M100 0 Q 120 100 100 200" />
                <path d="M160 0 Q 140 100 160 200" stroke="rgba(242,238,230,.25)" />
              </svg>
            )}
            {theme.svgShape === 'triangle' && (
              <svg viewBox="0 0 200 200" fill="none" stroke="#C8FF2E" stroke-width="1" width="100%" height="100%">
                <polygon points="100,20 180,160 20,160" />
                <polygon points="100,55 150,145 50,145" stroke="rgba(242,238,230,.5)" />
                <line x1="100" y1="20" x2="100" y2="180" stroke="rgba(242,238,230,.2)" />
                <line x1="20" y1="160" x2="180" y2="160" stroke="rgba(242,238,230,.2)" />
              </svg>
            )}
            {theme.svgShape === 'squares' && (
              <svg viewBox="0 0 200 200" fill="none" stroke="#C8FF2E" stroke-width="1" width="100%" height="100%">
                <rect x="40" y="40" width="120" height="120" transform="rotate(12 100 100)" stroke="rgba(242,238,230,.35)" />
                <rect x="60" y="60" width="80" height="80" transform="rotate(-18 100 100)" />
                <circle cx="100" cy="100" r="6" fill="#C8FF2E" stroke="none" />
              </svg>
            )}
          </div>
        </article>
      ))}
    </div>

    <div class="themes-note label">
      <span>Official themes: <span class="ph">{THEMES_NOTE.officialStatus}</span></span>
      <span>Each track: <span class="ph">{THEMES_NOTE.prizeStatus}</span></span>
    </div>

    <div class="reveal" style="margin-top:2.5rem;display:flex;justify-content:flex-end">
      <a href="/themes/" class="btn btn-ghost">
        Explore All Problem Spaces &amp; Specifications <span class="arrow">→</span>
      </a>
    </div>
  </div>
</section>
