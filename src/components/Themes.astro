---
import { THEMES_LIST, THEMES_NOTE } from '../data/themes';
import ThemeCard from './ThemeCard.astro';
---

<section class="section" id="themes" aria-labelledby="themes-title">
  <div class="wrap">
    <div class="section-head reveal">
      <span class="idx">02 — Themes</span>
      <span class="label">Problem Spaces · 2026</span>
    </div>

    <div style="display:flex;justify-content:space-between;align-items:end;gap:2rem;flex-wrap:wrap;margin-bottom:3rem">
      <h2 class="h2 reveal" id="themes-title" style="margin:0">
        Four<br />fields.<br /><span class="outline-text">One</span> system.
      </h2>
      <p class="body reveal" style="--d:.1s;margin:0">
        Explore the four core problem tracks for Confluence 2026. Hover or focus a row to preview its visual language.
      </p>
    </div>

    <div class="themes-list">
      {THEMES_LIST.map((theme, idx) => (
        <ThemeCard theme={theme} delayIndex={idx} />
      ))}
    </div>

    <div class="themes-note label">
      <span>Official tracks: <span style="color:var(--acid);font-weight:600">{THEMES_NOTE.officialStatus}</span></span>
      <span>Prize Pool: <span style="color:var(--ink);font-weight:600">{THEMES_NOTE.prizeStatus}</span></span>
    </div>
  </div>
</section>
