---
// src/components/ThemeCard.astro — Reusable theme card component
import type { ThemeItem } from '../types';

interface Props {
  theme: ThemeItem;
  delayIndex?: number;
}

const { theme, delayIndex = 0 } = Astro.props;
---

<article
  class="theme reveal"
  style={delayIndex > 0 ? `--d:${delayIndex * 0.05}s` : undefined}
  tabindex="0"
  data-hover
>
  <span class="theme-num">{theme.number}</span>
  <div>
    <h3 class="theme-title">
      {theme.title} {theme.isPlaceholderTitle && <span class="ph" style="font-size:.3em;vertical-align:middle">[TBA]</span>}
    </h3>
  </div>
  <p class="theme-desc">
    {theme.description}
    <span class="tag label">{theme.trackTag}</span>
  </p>
  <span class="theme-arrow" aria-hidden="true">↗</span>

  <div class="theme-visual" aria-hidden="true">
    {theme.svgShape === 'concentric' && (
      <svg viewBox="0 0 200 200" fill="none" stroke="#C8FF2E" stroke-width="1">
        <circle cx="100" cy="100" r="80" stroke="rgba(242,238,230,.2)"/>
        <circle cx="100" cy="100" r="55"/>
        <circle cx="100" cy="100" r="30" stroke="rgba(242,238,230,.5)"/>
        <line x1="20" y1="100" x2="180" y2="100" stroke="rgba(242,238,230,.2)"/>
        <line x1="100" y1="20" x2="100" y2="180" stroke="rgba(242,238,230,.2)"/>
        <circle cx="100" cy="100" r="3" fill="#C8FF2E" stroke="none"/>
      </svg>
    )}
    {theme.svgShape === 'flow' && (
      <svg viewBox="0 0 200 200" fill="none" stroke="#C8FF2E" stroke-width="1">
        <g stroke="rgba(242,238,230,.35)">
          <path d="M0 30 Q100 80 200 30"/><path d="M0 70 Q100 120 200 70"/><path d="M0 110 Q100 160 200 110"/><path d="M0 150 Q100 200 200 150"/>
        </g>
        <path d="M40 0 Q 60 100 40 200" stroke="rgba(242,238,230,.25)"/>
        <path d="M100 0 Q 120 100 100 200"/>
        <path d="M160 0 Q 140 100 160 200" stroke="rgba(242,238,230,.25)"/>
      </svg>
    )}
    {theme.svgShape === 'triangle' && (
      <svg viewBox="0 0 200 200" fill="none" stroke="#C8FF2E" stroke-width="1">
        <polygon points="100,20 180,160 20,160" />
        <polygon points="100,55 150,145 50,145" stroke="rgba(242,238,230,.5)"/>
        <line x1="100" y1="20" x2="100" y2="180" stroke="rgba(242,238,230,.2)"/>
        <line x1="20" y1="160" x2="180" y2="160" stroke="rgba(242,238,230,.2)"/>
      </svg>
    )}
    {theme.svgShape === 'squares' && (
      <svg viewBox="0 0 200 200" fill="none" stroke="#C8FF2E" stroke-width="1">
        <rect x="40" y="40" width="120" height="120" transform="rotate(12 100 100)" stroke="rgba(242,238,230,.35)"/>
        <rect x="60" y="60" width="80" height="80" transform="rotate(-18 100 100)"/>
        <circle cx="100" cy="100" r="6" fill="#C8FF2E" stroke="none"/>
      </svg>
    )}
  </div>
</article>
