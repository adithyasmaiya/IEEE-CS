---
import { FAQ_LIST } from '../data/faq';
import FaqItem from './FaqItem.astro';
---

<section class="section" id="faq" aria-labelledby="faq-title">
  <div class="wrap">
    <div class="section-head reveal">
      <span class="idx">04 — FAQs</span>
      <span class="label">Questions · Answers</span>
    </div>

    <div class="faq-grid">
      <aside class="faq-aside reveal">
        <h2 class="h2" id="faq-title">Good<br />questions.</h2>
        <p class="body" style="margin:1.5rem 0 0">
          Can't find what you need? Reach out through the contact channels in the footer or visit the support desk.
        </p>
      </aside>

      <div class="faq-list">
        {FAQ_LIST.map((item) => (
          <FaqItem item={item} />
        ))}
      </div>
    </div>
  </div>
</section>
