---
import { EVENT_CONFIG } from '../data/event';
import { NAV_ITEMS } from '../data/navigation';

const currentYear = new Date().getFullYear();
// Normalize phone number for RFC 3966 mobile click-to-call compatibility
const normalizedPhoneHref = EVENT_CONFIG.contact.phone
  ? `tel:${EVENT_CONFIG.contact.phone.replace(/[\s\(\)-]/g, '').replace('+910', '+91')}`
  : 'tel:+918026721983';
---

<footer>
  <div class="footer-grid">
    <div class="footer-brand">
      <a href="/" class="wordmark">
        {EVENT_CONFIG.name}<sup>/{EVENT_CONFIG.edition.slice(-2)}</sup>
      </a>
      <p>
        The flagship hackathon of {EVENT_CONFIG.organizer}, {EVENT_CONFIG.university}, {EVENT_CONFIG.city}.
      </p>
    </div>

    <div>
      <h4>Navigate</h4>
      <ul>
        {NAV_ITEMS.map((item) => (
          <li>
            <a href={item.href}>{item.label}</a>
          </li>
        ))}
        <li>
          <a href="/register/">Register</a>
        </li>
      </ul>
    </div>

    <div>
      <h4>Contact</h4>
      <ul>
        <li>
          {EVENT_CONFIG.contact.email && !EVENT_CONFIG.contact.email.includes('[') ? (
            <a href={`mailto:${EVENT_CONFIG.contact.email}`}>{EVENT_CONFIG.contact.email}</a>
          ) : (
            <span class="ph">{EVENT_CONFIG.contact.email}</span>
          )}
        </li>
        <li>
          {EVENT_CONFIG.contact.phone && !EVENT_CONFIG.contact.phone.includes('[') ? (
            <a href={normalizedPhoneHref}>{EVENT_CONFIG.contact.phone}</a>
          ) : (
            <span class="ph">{EVENT_CONFIG.contact.phone}</span>
          )}
        </li>
        <li>
          {EVENT_CONFIG.contact.address && !EVENT_CONFIG.contact.address.includes('[') ? (
            <span style="color:var(--muted);font-size:.82rem;line-height:1.4;display:block">{EVENT_CONFIG.contact.address}</span>
          ) : (
            <span class="ph">{EVENT_CONFIG.contact.address}</span>
          )}
        </li>
      </ul>
    </div>

    <div>
      <h4>Social</h4>
      <ul>
        {EVENT_CONFIG.socialLinks.map((s) => (
          <li>
            {s.url && s.url.startsWith('http') ? (
              <a
                href={s.url}
                target="_blank"
                rel="noopener noreferrer"
              >
                {s.platform}
              </a>
            ) : (
              <span style="color:var(--muted)">
                {s.platform} <span class="ph">{s.placeholderText || '[LINK TBA]'}</span>
              </span>
            )}
          </li>
        ))}
      </ul>
    </div>
  </div>

  <p class="footer-giant" aria-hidden="true">{EVENT_CONFIG.name}</p>

  <div class="footer-bottom">
    <span class="label">
      © <span id="year">{currentYear}</span> {EVENT_CONFIG.organizer} · {EVENT_CONFIG.university}. All rights reserved.
    </span>
    <span class="label">
      IEEE CS PESU · {EVENT_CONFIG.city} · <a href="#top" style="color:var(--acid)">Back to top ↑</a>
    </span>
  </div>
</footer>
